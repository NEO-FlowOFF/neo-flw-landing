# ===========================================
# neoflowoff.agency Landing - Environment Variables
# ===========================================
#
# Runtime atual:
# - Astro static site
# - Cloudflare Pages Functions em /functions
# - Cloudflare Pages como deploy
#
# Este arquivo e apenas um modelo. Nunca inclua valores reais aqui.
# Secrets devem ficar no ambiente server-side da Cloudflare, nao no frontend.

# --------------------------------------------
# Site Configuration
# --------------------------------------------

NODE_ENV=production
SITE_URL=https://neoflowoff.agency/
CORS_ORIGINS=https://neoflowoff.agency,https://www.neoflowoff.agency

# --------------------------------------------
# Analytics & Tracking
# --------------------------------------------

META_PIXEL_ID=2051453138833455

# --------------------------------------------
# Meta App - Tech Provider / Embedded Signup
# --------------------------------------------

# App ID publico/canonico do NEØFLW ENGINE:one.
META_APP_ID=1500002841696407
META_APP_NAME="NEØFLW ENGINE:one"
META_APP_NAMESPACE=neoflw-engine

# Versao da Graph API usada pelo adapter server-side.
META_GRAPH_API_VERSION=v25.0

# Redirect URI configurada no app Meta para o Embedded Signup.
# Deve ser exatamente igual no codigo, neste arquivo e no painel Meta.
# Forma canonica atual: sem barra final.
# Nao misture com https://neoflowoff.agency/conectar-whatsapp/
META_OAUTH_REDIRECT_URI=https://neoflowoff.agency/conectar-whatsapp

# Secret do app Meta.
# Obrigatorio para:
# - validar signed_request do Data Deletion Callback;
# - trocar authorization code por token quando o fallback local for usado.
# - validar assinaturas Meta no gateway WhatsApp quando aplicavel.
# Configure como secret server-side na Cloudflare.
META_APP_SECRET=replace_with_meta_app_secret

# --------------------------------------------
# WhatsApp Integration
# --------------------------------------------
#
# Variaveis de contrato para o gateway WhatsApp Docker/backend soberano.
# Elas nao devem ser expostas no frontend.

WHATSAPP_CONTACT=+556294789032
WHATSAPP_BUSINESS_ACCOUNT_ID=replace_with_waba_id
WHATSAPP_PHONE_NUMBER_ID=replace_with_phone_number_id
META_WEBHOOK_VERIFY_TOKEN=replace_with_webhook_verify_token
WHATSAPP_TEMPLATE_NAMESPACE=replace_with_template_namespace

# --------------------------------------------
# Meta Embedded Signup - destino seguro
# --------------------------------------------
#
# Escolha uma estrategia por fluxo:
# Configure forward OU fallback KV.
# Nunca ative os dois sem precedencia explicita no codigo e na operacao.
#
# 1. Encaminhar o authorization code para o backend soberano.
#    Recomendado quando o NEØ Growth System estiver pronto para receber o evento.
#
# 2. Armazenar token criptografado em KV como fallback fechado.
#    Exige binding KV META_CONNECTIONS e META_TOKEN_ENCRYPTION_KEY.

# Estrategia 1: forward server-to-server.
META_EMBEDDED_SIGNUP_FORWARD_URL=
META_EMBEDDED_SIGNUP_FORWARD_SECRET=

# Estrategia 2: fallback local com KV.
# META_CONNECTIONS e binding KV, nao variavel de ambiente textual.
META_TOKEN_ENCRYPTION_KEY=

# --------------------------------------------
# Meta Data Deletion Callback
# --------------------------------------------
#
# Endpoint publico:
# https://neoflowoff.agency/api/meta/data-deletion
#
# Pagina publica de acompanhamento:
# https://neoflowoff.agency/excluir-dados
#
# Escolha uma estrategia por fluxo:
# Configure forward OU fallback KV.
# Nunca ative os dois sem precedencia explicita no codigo e na operacao.
#
# 1. Encaminhar a solicitacao para backend soberano.
# 2. Registrar a solicitacao em KV META_DELETION_REQUESTS.

# Estrategia 1: forward server-to-server.
META_DATA_DELETION_FORWARD_URL=
META_DATA_DELETION_FORWARD_SECRET=

# Estrategia 2: fallback local com KV.
# META_DELETION_REQUESTS e binding KV declarado em wrangler.jsonc/Cloudflare,
# nao variavel de ambiente textual.

# --------------------------------------------
# Pagamentos
# --------------------------------------------
#
# FlowPay sera o no externo de pagamentos.
# Este checkout Astro ainda nao possui rota ativa de cobranca.
# Nao configure WOOVI, OPENPIX, FLOWPAY_* ou chaves de pagamento aqui ate
# existir contrato runtime consumido por este repositorio.
