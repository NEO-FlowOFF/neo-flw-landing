---
import Base from '../../layouts/Base.astro';
import catalogData from '../../data/catalog.json';
import uiTexts from '../../data/ui_texts.json';
import steelLogoImage from '../../assets/images/steel_flw.webp';

export function getStaticPaths() {
  const servicos = catalogData.products.filter(p => p.category === 'Serviço');
  return servicos.map(servico => ({
    params: { slug: servico.slug },
    props: { servico },
  }));
}

const { servico } = Astro.props;
---
<Base title={`${servico.title} | Neo FlowOFF Agency`} description={`${servico.description} Serviço de infraestrutura comercial, automação e IA da Neo FlowOFF Agency em Goiânia.`}>
  <div class="detail-page">
    <header class="detail-header">
      <a href="/" class="back-link">
        <i data-lucide="chevron-left"></i>
        <span>{uiTexts.product_page.back_button}</span>
      </a>
    </header>

    <article class="detail-hero">
      <div class="detail-hero-copy">
        <div class="detail-kicker">{servico.display_category || uiTexts.product_page.service_label}</div>
        <h1>{servico.title}</h1>
        <p>{servico.description}</p>
      </div>
      <aside class="detail-price-panel" aria-label="Resumo de preço">
        {servico.price_label && <span>{servico.price_label}</span>}
        <strong>{servico.price_display || (servico.price.value > 0 ? `R$ ${servico.price.value.toLocaleString('pt-BR', { minimumFractionDigits: 2 })}` : 'Sob consulta')}</strong>
        <small>Escopo validado antes da ativação.</small>
      </aside>
    </article>

    <section class="detail-section">
      <div class="section-label">{uiTexts.product_page.included_features_label}</div>
      <ul class="detail-list">
        {servico.features.map(feature => (
          <li>
            <i data-lucide="check-circle"></i>
            <span>{feature}</span>
          </li>
        ))}
      </ul>
    </section>

    {servico.outcomes && (
      <section class="detail-section detail-section--panel">
        <div class="section-label">{uiTexts.product_page.outcomes_label}</div>
        <ul class="detail-list detail-list--outcomes">
          {servico.outcomes.map(outcome => (
            <li>
              <i data-lucide="sparkles"></i>
              <span>{outcome}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="detail-cta" aria-label="Próximo passo">
      <p>
        {uiTexts.product_page.pricing_notice}
      </p>

      <div class="detail-actions">
        <button class="detail-action detail-action--primary">
          <i data-lucide="credit-card"></i>
          <span>{uiTexts.product_page.checkout_button}</span>
        </button>

        <a href={`https://wa.me/556282705594?text=Olá!%20Gostaria%20de%20validar%20o%20escopo%20do%20serviço%20${encodeURIComponent(servico.title)}`} target="_blank" rel="noopener noreferrer" class="detail-action detail-action--secondary">
          <i data-lucide="message-circle"></i>
          <span>{uiTexts.product_page.contact_button}</span>
        </a>
      </div>
    </section>

    <footer class="detail-footer">
      <img class="detail-footer-logo" src={steelLogoImage.src} width={steelLogoImage.width} height={steelLogoImage.height} alt="Logotipo Neo FlowOFF Agency - infraestrutura comercial e IA" loading="lazy" decoding="async" />
      <p>
        {uiTexts.footer.tagline}
      </p>
      <img class="detail-footer-badge" src="/assets/badge_meta_tech_provider.webp" alt="Neo FlowOFF Agency - Meta Tech Provider para WhatsApp Business API" loading="lazy" decoding="async" width="1400" height="401" />
      <p class="footer-legal-entity">
        <span>Flowoff Marketing e Assessoria Digital LTDA</span>
        <span class="footer-legal-nobreak">• CNPJ: 43.376.355/0001-92</span>
        <span class="footer-legal-nobreak">• neo@neoflowoff.agency</span>
      </p>
    </footer>
  </div>

  <script is:inline define:vars={{
    title: servico.title,
    id: servico.slug,
    price: servico.price.value
  }}>
    // 1. ViewContent
    if (typeof ttq !== 'undefined') {
      ttq.track('ViewContent', {
        contents: [{
          content_id: id,
          content_name: title,
          content_type: 'product'
        }],
        value: price,
        currency: 'BRL'
      });
    }
    if (typeof fbq !== 'undefined') {
      fbq('track', 'ViewContent', {
        content_name: title,
        content_ids: [id],
        content_type: 'product',
        value: price,
        currency: 'BRL'
      });
    }

    // 2. Click tracking for CTA buttons
    document.addEventListener('DOMContentLoaded', () => {
      const checkoutBtn = document.querySelector('.detail-action--primary');
      const whatsappBtn = document.querySelector('.detail-action--secondary');

      if (checkoutBtn) {
        checkoutBtn.addEventListener('click', () => {
          if (typeof ttq !== 'undefined') {
            ttq.track('InitiateCheckout', {
              contents: [{
                content_id: id,
                content_name: title,
                content_type: 'product'
              }],
              value: price,
              currency: 'BRL'
            });
          }
          if (typeof fbq !== 'undefined') {
            fbq('track', 'InitiateCheckout', {
              content_name: title,
              content_ids: [id],
              content_type: 'product',
              value: price,
              currency: 'BRL'
            });
          }
        });
      }

      if (whatsappBtn) {
        whatsappBtn.addEventListener('click', () => {
          if (typeof ttq !== 'undefined') {
            ttq.track('CompletePayment', {
              contents: [{
                content_id: id,
                content_name: title,
                content_type: 'product'
              }],
              value: price,
              currency: 'BRL'
            });
          }
          if (typeof fbq !== 'undefined') {
            fbq('track', 'Purchase', {
              content_name: title,
              content_ids: [id],
              content_type: 'product',
              value: price,
              currency: 'BRL'
            });
          }
        });
      }
    });
  </script>
</Base>
