  <script is:inline>
    // Access Gate Controller
    function checkGateAccess() {
      const urlParams = new URLSearchParams(window.location.search);
      const queryKey = urlParams.get('auth') || urlParams.get('token') || urlParams.get('key');
      const storedKey = sessionStorage.getItem('neo_waba_auth');
      const activeKey = queryKey || storedKey;

      if (isValidAccessKey(activeKey)) {
        unlockGateUI(activeKey);
      } else {
        lockGateUI();
      }
    }

    function isValidAccessKey(key) {
      if (!key) return false;
      const clean = String(key).trim();
      const hasValidPrefix =
        clean.startsWith('flw_sec_') ||
        clean.startsWith('flw_auth_') ||
        clean.startsWith('flw_') ||
        clean.startsWith('flow_') ||
        clean.startsWith('neo_');
      return hasValidPrefix && clean.length >= 10;
    }

    function unlockGateUI(key) {
      sessionStorage.setItem('neo_waba_auth', key);
      const gateEl = document.getElementById('access-gate-block');
      const connectorEl = document.getElementById('connector-active-block');
      if (gateEl) gateEl.hidden = true;
      if (connectorEl) connectorEl.hidden = false;
    }

    function lockGateUI() {
      sessionStorage.removeItem('neo_waba_auth');
      const gateEl = document.getElementById('access-gate-block');
      const connectorEl = document.getElementById('connector-active-block');
      if (gateEl) gateEl.hidden = false;
      if (connectorEl) connectorEl.hidden = true;
    }

    document.addEventListener('DOMContentLoaded', () => {
      checkGateAccess();

      const form = document.getElementById('gate-key-form');
      const input = document.getElementById('gate-access-key-input');
      const errorEl = document.getElementById('gate-key-error');
      const lockBtn = document.getElementById('btn-lock-session');

      if (form && input) {
        form.addEventListener('submit', (e) => {
          e.preventDefault();
          const val = input.value.trim();
          if (isValidAccessKey(val)) {
            if (errorEl) errorEl.hidden = true;
            unlockGateUI(val);
          } else {
            if (errorEl) {
              errorEl.textContent = 'Chave inválida. Utilize sua chave oficial (ex: flw_...) ou solicite ativação.';
              errorEl.hidden = false;
            }
          }
        });
      }

      if (lockBtn) {
        lockBtn.addEventListener('click', () => {
          lockGateUI();
        });
      }
    });
  </script>
