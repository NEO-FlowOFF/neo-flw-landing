  media: `screen and (device-width: ${width}px) and (device-height: ${height}px) and (-webkit-device-pixel-ratio: ${ratio}) and (orientation: ${orientation})`,
  href: `/splash_screens/${file}`,
}));
// Search schema uses the keyboard-friendly name and maps NEØ as alternateName.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfessionalService',
      '@id': `${platformBaseUrl}/#organization`,
      name: brandSearchName,
      alternateName: brandAlternateNames,
      legalName: 'Flowoff Marketing e Assessoria Digital LTDA',
      url: platformBaseUrl,
      logo: {
        '@type': 'ImageObject',
        url: `${platformBaseUrl}/icon-512.png`,
        contentUrl: `${platformBaseUrl}/icon-512.png`,
        width: 512,
        height: 512,
        caption: 'Logotipo Neo FlowOFF Agency'
      },
      image: ogImageUrl,
      description: `Neo FlowOFF Agency, marca ${brandOfficialName}, atua com ${brandCategoryDescription}`,
      slogan: 'Marketing com infraestrutura.',
      telephone: '+55-62-94789032',
      email: 'neo@neoflowoff.agency',
