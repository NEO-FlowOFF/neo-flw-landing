---
import '../styles/global.css';
import fs from 'node:fs';
import path from 'node:path';
import uiTexts from '../data/ui_texts.json';

// Read config to get meta verification token
const configPath = path.join(process.cwd(), 'src/data/config.json');
const configData = JSON.parse(fs.readFileSync(configPath, 'utf8'));
const metaVerifyToken = configData.integrations.meta.domain_verification;
const platformBaseUrl = String(configData.platform.base_url || 'https://neoflowoff.agency').replace(/\/$/, '');
const canonicalUrl = new URL(Astro.url.pathname, platformBaseUrl).toString();
const title = Astro.props.title || uiTexts.meta.default_title;
const description = Astro.props.description || uiTexts.meta.default_description;
const keywords = uiTexts.meta.keywords.join(', ');
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${platformBaseUrl}/#organization`,
      name: 'NEØ FlowOFF',
      alternateName: 'Neo FlowOFF Agency',
      url: platformBaseUrl,
      logo: `${platformBaseUrl}/icon-512.png`,
      description,
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'customer support',
        email: 'neo@neoflowoff.agency',
        availableLanguage: ['pt-BR']
      }
    },
    {
      '@type': 'WebSite',
      '@id': `${platformBaseUrl}/#website`,
      url: platformBaseUrl,
      name: 'neoflowoff.agency',
      publisher: {
        '@id': `${platformBaseUrl}/#organization`
      }
    },
    {
      '@type': 'WebPage',
      '@id': canonicalUrl,
      url: canonicalUrl,
      name: title,
      description,
      inLanguage: 'pt-BR',
      isPartOf: {
        '@id': `${platformBaseUrl}/#website`
      },
      about: {
        '@id': `${platformBaseUrl}/#organization`
      }
    }
  ]
};
---

<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={uiTexts.meta.og_title} />
    <meta property="og:description" content={uiTexts.meta.og_description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="theme-color" content="#16161a" />
    <meta name="facebook-domain-verification" content={metaVerifyToken} />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)}></script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Mono:ital,wght@0,300;0,400;0,500;1,300;1,400;1,500&family=Figtree:ital,wght@0,300..900;1,300..900&display=swap" media="print" onload="this.media='all'">
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Mono:ital,wght@0,300;0,400;0,500;1,300;1,400;1,500&family=Figtree:ital,wght@0,300..900;1,300..900&display=swap">
    </noscript>
  </head>
  <body>
    <div class="mesh"></div>
    <slot />
    <script>
      const iconPaths: Record<string, string> = {
        activity: '<path d="M22 12h-4l-3 9L9 3l-3 9H2"></path>',
        'bar-chart-3': '<path d="M3 3v18h18"></path><path d="M18 17V9"></path><path d="M13 17V5"></path><path d="M8 17v-3"></path>',
        bot: '<path d="M12 8V4H8"></path><rect width="16" height="12" x="4" y="8" rx="2"></rect><path d="M2 14h2"></path><path d="M20 14h2"></path><path d="M15 13v2"></path><path d="M9 13v2"></path>',
        box: '<path d="m21 8-9-5-9 5 9 5 9-5Z"></path><path d="M3 8v8l9 5 9-5V8"></path><path d="M12 13v8"></path>',
        'check-circle': '<path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><path d="m9 11 3 3L22 4"></path>',
        'chevron-left': '<path d="m15 18-6-6 6-6"></path>',
        'chevron-right': '<path d="m9 18 6-6-6-6"></path>',
        contact: '<path d="M16 2v4"></path><path d="M8 2v4"></path><rect width="18" height="18" x="3" y="4" rx="2"></rect><circle cx="12" cy="11" r="3"></circle><path d="M17 19a5 5 0 0 0-10 0"></path>',
        cpu: '<rect width="16" height="16" x="4" y="4" rx="2"></rect><rect width="6" height="6" x="9" y="9" rx="1"></rect><path d="M15 2v2"></path><path d="M15 20v2"></path><path d="M9 2v2"></path><path d="M9 20v2"></path><path d="M2 15h2"></path><path d="M2 9h2"></path><path d="M20 15h2"></path><path d="M20 9h2"></path>',
        'credit-card': '<rect width="20" height="14" x="2" y="5" rx="2"></rect><path d="M2 10h20"></path>',
        'git-branch': '<line x1="6" x2="6" y1="3" y2="15"></line><circle cx="18" cy="6" r="3"></circle><circle cx="6" cy="18" r="3"></circle><path d="M18 9a9 9 0 0 1-9 9"></path>',
        grid: '<rect width="7" height="7" x="3" y="3" rx="1"></rect><rect width="7" height="7" x="14" y="3" rx="1"></rect><rect width="7" height="7" x="14" y="14" rx="1"></rect><rect width="7" height="7" x="3" y="14" rx="1"></rect>',
        home: '<path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z"></path><path d="M9 22V12h6v10"></path>',
        layers: '<path d="m12 2 10 5-10 5L2 7l10-5Z"></path><path d="m2 17 10 5 10-5"></path><path d="m2 12 10 5 10-5"></path>',
        layout: '<rect width="18" height="18" x="3" y="3" rx="2"></rect><path d="M3 9h18"></path><path d="M9 21V9"></path>',
        menu: '<path d="M4 12h16"></path><path d="M4 6h16"></path><path d="M4 18h16"></path>',
        'message-circle': '<path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"></path>',
        'message-square': '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2Z"></path>',
        search: '<circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path>',
        'share-2': '<circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><path d="m8.59 13.51 6.83 3.98"></path><path d="m15.41 6.51-6.82 3.98"></path>',
        shield: '<path d="M20 13c0 5-3.5 7.5-7.7 8.9a1 1 0 0 1-.6 0C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.2-2.7a1.2 1.2 0 0 1 1.6 0C14.5 3.8 17 5 19 5a1 1 0 0 1 1 1Z"></path>',
        'shield-alert': '<path d="M20 13c0 5-3.5 7.5-7.7 8.9a1 1 0 0 1-.6 0C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.2-2.7a1.2 1.2 0 0 1 1.6 0C14.5 3.8 17 5 19 5a1 1 0 0 1 1 1Z"></path><path d="M12 8v4"></path><path d="M12 16h.01"></path>',
        'shield-check': '<path d="M20 13c0 5-3.5 7.5-7.7 8.9a1 1 0 0 1-.6 0C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.2-2.7a1.2 1.2 0 0 1 1.6 0C14.5 3.8 17 5 19 5a1 1 0 0 1 1 1Z"></path><path d="m9 12 2 2 4-4"></path>',
        sparkles: '<path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3Z"></path>',
        terminal: '<path d="m4 17 6-6-6-6"></path><path d="M12 19h8"></path>',
        'trash-2': '<path d="M3 6h18"></path><path d="M8 6V4h8v2"></path><path d="M19 6l-1 14H6L5 6"></path><path d="M10 11v6"></path><path d="M14 11v6"></path>',
        x: '<path d="M18 6 6 18"></path><path d="m6 6 12 12"></path>',
        zap: '<path d="M4 14a1 1 0 0 1-.8-1.6l9-10A1 1 0 0 1 14 3v7h6a1 1 0 0 1 .8 1.6l-9 10A1 1 0 0 1 10 21v-7Z"></path>',
      };

      const createIcons = () => {
        document.querySelectorAll<HTMLElement>('[data-lucide]').forEach((icon) => {
          const name = icon.dataset.lucide || '';
          const path = iconPaths[name];
          if (!path) return;
          icon.setAttribute('aria-hidden', 'true');
          icon.innerHTML = `<svg viewBox="0 0 24 24" width="100%" height="100%" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${path}</svg>`;
        });
      };

      (window as Window & { lucide?: { createIcons: () => void } }).lucide = { createIcons };
      createIcons();

      // Haptic feedback utility
      // Simple vibration helper – works only on devices that support the Vibration API (Android).
      const hapticVibrate = (pattern = 10) => {
        if (typeof navigator !== "undefined" && "vibrate" in navigator) {
          try {
            return navigator.vibrate(pattern);
          } catch {
            return false;
          }
        }
        return false;
      };
      // Expose a convenient click helper on the window object.
      (window as any).haptic = { click: () => hapticVibrate(10) };
      // Global listener: any element with a `data-haptic` attribute triggers a short vibration on click.
      document.addEventListener("click", (e) => {
        const el = e.target;
        if (el instanceof HTMLElement && el.dataset.haptic !== undefined) {
          hapticVibrate(10);
        }
      });


      // Register PWA Service Worker
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
    </script>
  </body>
</html>
