---
import Base from '../layouts/Base.astro';
import configData from '../data/config.json';
import brandLogo from '../assets/logos/neoflowoff-logo26-2.webp';

const metaConfig = configData.integrations.meta;
const metaAppId = metaConfig.app_id;
const graphApiVersion = metaConfig.graph_api_version;
const requestedScopes = metaConfig.requested_scopes.join(',');
---

<Base title="Conectar WhatsApp Business | Meta Tech Provider — neoflowoff.agency" description="Conexão oficial via Meta Cloud API para WhatsApp Business.">
  <div class="wa-page-wrapper">
    <div class="wa-page-container">
      <!-- HEADER COM LOGO DA AGÊNCIA (SEM MENU HAMBÚRGUER) -->
      <header class="clean-header">
        <div class="glass-navbar-simple">
          <a href="/" class="nav-brand">
            <span class="portal-brand-text">neoflowoff.portal</span>
          </a>
          <div class="header-status-badge">
            <span class="status-dot"></span>
            <span class="status-text">// NEØ GROWTH SYSTEM</span>
          </div>
        </div>
      </header>

      <!-- CARD MINIMALISTA E MODERNO -->
      <main class="wa-card">

        <!-- LOGO META TECH PROVIDER -->
        <div class="meta-brand-header">
          <img
            src="/lgo-app-stell.png"
            alt="NEØFLW ENGINE:one Meta App"
            class="meta-badge-img"
            width="78"
            height="39"
            loading="eager"
          />
        </div>

        <!-- TAG MINIMALISTA -->
        <div class="meta-tag">
          <span class="pulse-dot"></span>
          <span>META BUSINESS MESSAGING CONNECTOR</span>
        </div>

        <!-- TÍTULO & SUBTÍTULO -->
        <h1 class="wa-card-title">
        <img
          src={brandLogo.src}
          alt="NEØ FlowOFF Agency"
          class="card-brand-logo-img"
          width="275"
          height="48"
          loading="eager"
        />
        </h1>
        <p class="wa-card-desc">
          Autorize os canais comerciais da sua empresa para integração com o <strong>NEØ Growth System</strong>.
        </p>

        <!-- BOTÃO AZUL OFICIAL META -->
        <div class="cta-wrapper">
          <button
            id="btn-meta-signup"
            onclick="launchWhatsAppSignup()"
            class="btn-meta-blue"
            data-haptic
            aria-label="Continuar com a Meta"
          >
            <svg class="meta-btn-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
            <span class="btn-text">Continuar com a Meta</span>
            <div class="btn-spinner" hidden></div>
          </button>
        </div>

        <!-- CAIXA DE STATUS -->
        <div id="signup-status" class="status-box" hidden></div>

        <!-- SELOS DE SEGURANÇA E CONEXÃO -->
        <div class="trust-grid">
          <div class="trust-card">
            <i data-lucide="shield-check" class="trust-icon"></i>
            <div>
              <strong>Autorização via Meta</strong>
              <small>Ambiente oficial de conexão</small>
            </div>
          </div>
          <div class="trust-card">
            <i data-lucide="zap" class="trust-icon"></i>
            <div>
              <strong>Orquestração NEØ</strong>
              <small>Integração com o Growth System</small>
            </div>
          </div>
        </div>

        <!-- FOOTER INFO DO APP -->
        <footer class="app-info-footer">
          <span>NEØFLW ENGINE:one</span>
          <span>·</span>
          <span><code>{metaAppId}</code></span>
        </footer>
      </main>

      <!-- FOOTER DE CONFORMIDADE -->
      <nav class="compliance-footer" aria-label="Links de conformidade">
        <a href="/privacidade/" class="compliance-link">Política de Privacidade</a>
        <span class="compliance-sep" aria-hidden="true">•</span>
        <a href="/legal/" class="compliance-link">Termos de Serviço</a>
        <span class="compliance-sep" aria-hidden="true">•</span>
        <a href="/excluir-dados/" class="compliance-link">Exclusão de Dados</a>
      </nav>
    </div>
  </div>

  <style>
    /* ─── PÁGINA ─── */
    .wa-page-wrapper {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 0.5rem 1rem 4rem;
      position: relative;
      isolation: isolate;
    }

    /* Glow ambiente no fundo */
    .wa-page-wrapper::before {
      content: '';
      position: fixed;
      inset: 0;
      background:
        radial-gradient(ellipse 70% 55% at 50% -10%, rgba(24, 119, 242, 0.14) 0%, transparent 65%),
        radial-gradient(ellipse 50% 40% at 80% 90%, rgba(143, 254, 9, 0.06) 0%, transparent 60%);
      pointer-events: none;
      z-index: -1;
    }

    .wa-page-container {
      width: 100%;
      max-width: 440px;
      margin: 0 auto;
    }

    /* ─── HEADER ─── */
    .clean-header {
      position: sticky;
      top: 12px;
      z-index: 100;
      margin-bottom: 2rem;
      width: 100%;
      animation: fadeUp 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    .glass-navbar-simple {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.6rem 1.1rem;
      background: rgba(23, 24, 23, 0.82);
      backdrop-filter: blur(20px) saturate(200%);
      -webkit-backdrop-filter: blur(20px) saturate(200%);
      border: 1px solid rgba(255, 255, 255, 0.09);
      border-radius: 999px;
      box-shadow:
        0 4px 24px rgba(0, 0, 0, 0.55),
        0 1px 0 rgba(255, 255, 255, 0.06) inset;
    }

    .nav-brand {
      display: flex;
      align-items: center;
      gap: 8px;
      text-decoration: none;
    }

    .portal-brand-text {
      color: rgba(255, 255, 255, 0.6);
      font-size: 0.85rem;
      font-weight: 500;
      letter-spacing: 0.01em;
    }

    .header-status-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 11px;
      border-radius: 999px;
      background: rgba(143, 254, 9, 0.07);
      border: 1px solid rgba(143, 254, 9, 0.22);
    }

    .status-dot {
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background: var(--acid);
      box-shadow: 0 0 7px var(--acid);
      animation: blink 2.4s ease-in-out infinite;
    }

    .status-text {
      font-family: var(--mono);
      font-size: 0.59rem;
      font-weight: 700;
      color: var(--acid);
      letter-spacing: 0.07em;
      opacity: 0.85;
    }

    /* ─── CARD PRINCIPAL ─── */
    .wa-card {
      position: relative;
      /* borda gradiente via pseudo-element */
      background: linear-gradient(165deg, rgba(26, 26, 34, 0.97) 0%, rgba(10, 10, 14, 0.99) 100%);
      border-radius: 12px;
      padding: 2.6rem 2.2rem 2rem;
      text-align: center;
      overflow: hidden;
      animation: fadeUp 0.55s 0.08s cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    /* Borda com gradiente sutil */
    .wa-card::before {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: 12px;
      padding: 1px;
      background: linear-gradient(
        160deg,
        rgba(255, 255, 255, 0.16) 0%,
        rgba(255, 255, 255, 0.04) 40%,
        rgba(24, 119, 242, 0.18) 100%
      );
      -webkit-mask:
        linear-gradient(#fff 0 0) content-box,
        linear-gradient(#fff 0 0);
      -webkit-mask-composite: xor;
      mask-composite: exclude;
      pointer-events: none;
    }

    /* Profundidade + glow azul no topo */
    .wa-card::after {
      content: '';
      position: absolute;
      top: -80px;
      left: 50%;
      transform: translateX(-50%);
      width: 320px;
      height: 320px;
      background: radial-gradient(circle, rgba(24, 119, 242, 0.18) 0%, transparent 68%);
      pointer-events: none;
      filter: blur(20px);
    }

    /* ─── LOGO APP / META ─── */
    .meta-brand-header {
      display: flex;
      justify-content: center;
      margin-bottom: 1.3rem;
      position: relative;
      z-index: 1;
    }

    .meta-badge-img {
      max-width: 120px;
      width: 100%;
      height: auto;
      object-fit: contain;
      filter: drop-shadow(0 0 12px rgba(24, 119, 242, 0.5));
    }

    /* ─── TAG CONNECTOR ─── */
    .meta-tag {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      font-family: var(--mono);
      font-size: 0.62rem;
      font-weight: 800;
      letter-spacing: 0.09em;
      color: #4fa3ff;
      background: rgba(24, 119, 242, 0.1);
      padding: 5px 15px;
      border-radius: 999px;
      border: 1px solid rgba(24, 119, 242, 0.28);
      margin-bottom: 1.4rem;
      position: relative;
      z-index: 1;
    }

    .pulse-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #1877F2;
      box-shadow: 0 0 8px #1877F2;
      animation: blink 2s infinite ease-in-out;
    }

    /* ─── TÍTULO / LOGO MARCA ─── */
    .wa-card-title {
      font-size: 1.5rem;
      font-weight: 900;
      color: #ffffff;
      margin-bottom: 0.7rem;
      text-transform: uppercase;
      letter-spacing: -0.01em;
      line-height: 1.2;
      position: relative;
      z-index: 1;
    }

    .card-brand-logo-img {
      max-width: 210px;
      width: 100%;
      height: auto;
      object-fit: contain;
      filter:
        drop-shadow(0 0 18px rgba(143, 254, 9, 0.24))
        drop-shadow(0 2px 8px rgba(0, 0, 0, 0.6));
      margin: 0.2rem auto 0.5rem;
      display: block;
    }

    .wa-card-desc {
      color: rgba(255, 255, 255, 0.58);
      font-size: 0.875rem;
      line-height: 1.6;
      margin-bottom: 2rem;
      position: relative;
      z-index: 1;
      max-width: 320px;
      margin-left: auto;
      margin-right: auto;
    }

    /* ─── BOTÃO META ─── */
    .cta-wrapper {
      margin-bottom: 1.4rem;
      position: relative;
      z-index: 1;
    }

    .btn-meta-blue {
      width: 100%;
      background: linear-gradient(180deg, #2385ff 0%, #1877F2 55%, #1464d8 100%);
      color: #ffffff;
      border: none;
      padding: 17px 24px;
      font-size: 0.96rem;
      font-weight: 700;
      letter-spacing: 0.01em;
      border-radius: 14px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      box-shadow:
        0 1px 0 rgba(255, 255, 255, 0.22) inset,
        0 -1px 0 rgba(0, 0, 0, 0.25) inset,
        0 8px 24px rgba(24, 119, 242, 0.42),
        0 2px 6px rgba(24, 119, 242, 0.28);
      transition: transform 0.2s ease, box-shadow 0.2s ease, filter 0.2s ease;
      position: relative;
      overflow: hidden;
    }

    /* shimmer no hover */
    .btn-meta-blue::after {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 60%;
      height: 100%;
      background: linear-gradient(
        105deg,
        transparent 20%,
        rgba(255, 255, 255, 0.12) 50%,
        transparent 80%
      );
      transition: left 0.45s ease;
    }

    .btn-meta-blue:hover:not(:disabled)::after {
      left: 160%;
    }

    .btn-meta-blue:hover:not(:disabled) {
      transform: translateY(-2px);
      box-shadow:
        0 1px 0 rgba(255, 255, 255, 0.22) inset,
        0 -1px 0 rgba(0, 0, 0, 0.25) inset,
        0 14px 36px rgba(24, 119, 242, 0.52),
        0 4px 10px rgba(24, 119, 242, 0.3);
      filter: brightness(1.06);
    }

    .btn-meta-blue:active:not(:disabled) {
      transform: translateY(0) scale(0.98);
      box-shadow:
        0 1px 0 rgba(255, 255, 255, 0.18) inset,
        0 4px 12px rgba(24, 119, 242, 0.32);
      filter: brightness(0.96);
    }

    .btn-meta-blue:disabled {
      opacity: 0.55;
      cursor: not-allowed;
    }

    .meta-btn-icon {
      flex-shrink: 0;
      color: #ffffff;
    }

    .btn-spinner {
      width: 18px;
      height: 18px;
      border: 2px solid rgba(255, 255, 255, 0.25);
      border-top-color: #ffffff;
      border-radius: 50%;
      animation: spin 0.65s linear infinite;
    }

    /* ─── STATUS BOX ─── */
    .status-box {
      margin-top: 1rem;
      margin-bottom: 1.2rem;
      padding: 0.9rem 1.15rem;
      border-radius: 12px;
      font-family: var(--mono);
      font-size: 0.74rem;
      line-height: 1.5;
      text-align: left;
      border: 1px solid transparent;
      animation: fadeIn 0.25s ease both;
      position: relative;
      z-index: 1;
    }

    .status-box.info {
      background: rgba(24, 119, 242, 0.1);
      border-color: rgba(24, 119, 242, 0.3);
      color: #7bbfff;
    }

    .status-box.success {
      background: rgba(143, 254, 9, 0.1);
      border-color: rgba(143, 254, 9, 0.38);
      color: var(--acid);
    }

    .status-box.warning {
      background: rgba(255, 179, 0, 0.1);
      border-color: rgba(255, 179, 0, 0.35);
      color: #ffc940;
    }

    .status-box.error {
      background: rgba(255, 82, 82, 0.1);
      border-color: rgba(255, 82, 82, 0.35);
      color: #ff8585;
    }

    /* ─── TRUST GRID ─── */
    .trust-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
      margin-top: 1.4rem;
      padding-top: 1.4rem;
      border-top: 1px solid rgba(255, 255, 255, 0.06);
      text-align: left;
      position: relative;
      z-index: 1;
    }

    .trust-card {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid rgba(255, 255, 255, 0.055);
      border-radius: 14px;
      padding: 0.8rem 0.85rem;
      transition: border-color 0.2s ease, background 0.2s ease;
    }

    .trust-card:hover {
      background: rgba(255, 255, 255, 0.038);
      border-color: rgba(255, 255, 255, 0.1);
    }

    .trust-card strong {
      display: block;
      font-size: 0.73rem;
      color: rgba(255, 255, 255, 0.88);
      line-height: 1.25;
      font-weight: 600;
    }

    .trust-card small {
      display: block;
      font-size: 0.63rem;
      color: rgba(255, 255, 255, 0.42);
      margin-top: 3px;
      line-height: 1.4;
    }

    .trust-icon {
      width: 16px;
      height: 16px;
      color: var(--acid);
    }

    /* ─── FOOTER ─── */
    .app-info-footer {
      margin-top: 1.8rem;
      padding-top: 1.1rem;
      border-top: 1px solid rgba(255, 255, 255, 0.05);
      font-family: var(--mono);
      font-size: 0.63rem;
      color: rgba(255, 255, 255, 0.3);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      flex-wrap: wrap;
      letter-spacing: 0.04em;
      position: relative;
      z-index: 1;
    }

    .app-info-footer code {
      color: rgba(255, 255, 255, 0.55);
      background: rgba(255, 255, 255, 0.05);
      padding: 2px 7px;
      border-radius: 5px;
      border: 1px solid rgba(255, 255, 255, 0.07);
    }

    /* ─── KEYFRAMES ─── */
    @keyframes fadeUp {
      from {
        opacity: 0;
        transform: translateY(14px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes blink {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.3; transform: scale(0.82); }
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(-5px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    /* ─── FOOTER DE CONFORMIDADE ─── */
    .compliance-footer {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      flex-wrap: wrap;
      margin-top: 1.6rem;
      padding: 0.6rem 0 0.2rem;
      animation: fadeUp 0.6s 0.2s cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    .compliance-link {
      font-family: var(--mono);
      font-size: 0.62rem;
      font-weight: 500;
      letter-spacing: 0.04em;
      color: rgba(255, 255, 255, 0.35);
      text-decoration: none;
      transition: color 0.18s ease;
    }

    .compliance-link:hover {
      color: rgba(255, 255, 255, 0.72);
    }

    .compliance-sep {
      font-size: 0.5rem;
      color: rgba(255, 255, 255, 0.18);
      line-height: 1;
    }
  </style>

  <script is:inline define:vars={{ metaAppId, graphApiVersion, requestedScopes }}>
    function setSignupStatus(message, tone) {
      const statusDiv = document.getElementById('signup-status');
      if (!statusDiv) return;
      statusDiv.hidden = false;
      statusDiv.className = 'status-box ' + (tone || 'info');
      statusDiv.textContent = message;
    }

    async function confirmEmbeddedSignup(authResponse) {
      const code = authResponse && authResponse.code;
      if (!code) {
        throw new Error('missing_authorization_code');
      }

      const response = await fetch('/api/meta/embedded-signup', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          code,
          grantedScopes: authResponse.grantedScopes || authResponse.granted_scopes || '',
          requestedScopes
        })
      });

      const payload = await response.json().catch(() => ({}));
      if (!response.ok || !payload.ok) {
        throw new Error(payload.error || 'embedded_signup_not_confirmed');
      }

      return payload;
    }

    window.fbAsyncInit = function() {
      if (window.FB) {
        FB.init({
          appId      : metaAppId,
          cookie     : true,
          xfbml      : true,
          version    : graphApiVersion
        });
      }
    };

    window.launchWhatsAppSignup = function() {
      const button = document.getElementById('btn-meta-signup');
      const spinner = button ? button.querySelector('.btn-spinner') : null;

      if (!window.FB) {
        setSignupStatus('O SDK da Meta ainda está inicializando. Aguarde 2 segundos e tente novamente.', 'error');
        return;
      }

      if (button) {
        button.setAttribute('disabled', 'disabled');
        if (spinner) spinner.hidden = false;
      }
      setSignupStatus('Conectando à API oficial da Meta...', 'info');

      FB.login(function (response) {
        if (response && response.authResponse) {
          setSignupStatus('Confirmando vinculação segura com o backend da NEØ FlowOFF...', 'info');
          confirmEmbeddedSignup(response.authResponse)
            .then(function() {
              setSignupStatus('✓ Conexão concluída com sucesso! Sua conta foi vinculada à infraestrutura soberana.', 'success');
            })
            .catch(function() {
              setSignupStatus('A autorização foi concedida na Meta, mas aguarda sincronização final com o servidor.', 'warning');
            })
            .finally(function() {
              if (button) {
                button.removeAttribute('disabled');
                if (spinner) spinner.hidden = true;
              }
            });
        } else {
          setSignupStatus('O fluxo de autorização da Meta foi fechado ou não concluído.', 'error');
          if (button) {
            button.removeAttribute('disabled');
            if (spinner) spinner.hidden = true;
          }
        }
      }, {
        scope: requestedScopes,
        return_scopes: true,
        response_type: 'code'
      });
    };
  </script>
  <script async defer crossorigin="anonymous" src="https://connect.facebook.net/pt_BR/sdk.js"></script>
</Base>
