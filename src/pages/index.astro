---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import HubHeader from '../components/HubHeader.astro';
import BrandFooter from '../components/BrandFooter.astro';
import catalogData from '../data/catalog.json';
import uiTexts from '../data/ui_texts.json';

const isMeta = (slug: string) =>
  slug?.includes('meta') || slug?.includes('whatsapp');

const metaProdutos = catalogData.products.filter((p) => isMeta(p.slug));
const planos = catalogData.products.filter(
  (p) => p.category === 'Plano' && !isMeta(p.slug)
);
const servicos = catalogData.products.filter(
  (p) => p.category === 'Serviço' && !isMeta(p.slug)
);
const tickerItems = [
  'Meta App: NEØFLW ENGINE:one homologado com renovação de acesso a dados e avaliação anual concluídas.',
  'Meta Tech Provider: infraestrutura oficial WhatsApp Business, Graph API v25.0 e webhooks em operação.',
];
const tickerLoopItems = [...tickerItems, ...tickerItems];
const pageTitle = 'NEØ FlowOFF Agency · Infraestrutura Comercial & Agentes de IA';
const pageDescription = 'Agência de engenharia comercial, agentes de IA, WhatsApp Business API oficial (Meta Tech Provider), CRM e automações para empresas em Goiânia e em todo o Brasil.';
---

<Base title={pageTitle} description={pageDescription}>
  <div class="home-page">
    <!-- TOP TELENOTÍCIAS TICKER BAR (Mídia & Infraestrutura) -->
    <div
      class="top-telenoticias-bar"
      style="width: 100vw; position: relative; left: 50%; right: 50%; margin-left: -50vw; margin-right: -50vw; background: #0b0b0e; color: #ffffff; padding: 7px 0; border-bottom: 1px solid rgba(255, 255, 255, 0.12); overflow: hidden; z-index: 1000;"
    >
      <div
        class="digital-ticker-portal"
        style="position: relative; width: 100%; overflow: hidden; -webkit-mask-image: linear-gradient(90deg, transparent 0px, transparent 1px, #000 2px, #000 calc(100% - 2px), transparent calc(100% - 1px), transparent 100%); mask-image: linear-gradient(90deg, transparent 0px, transparent 1px, #000 2px, #000 calc(100% - 2px), transparent calc(100% - 1px), transparent 100%);"
      >
        <div
          class="ticker-track"
          style="display: flex; width: max-content; animation: ticker-loop 24s linear infinite; gap: 2.5rem;"
        >
          {
            tickerLoopItems.map((item) => (
              <span style="font-family: var(--mono); font-size: 0.72rem; font-weight: 800; color: #ffffff; text-transform: uppercase; letter-spacing: 0.05em; white-space: nowrap; display: inline-flex; align-items: center; gap: 0.7rem;">
                <span style="background: var(--acid); color: #000; font-size: 0.58rem; padding: 2px 6px; border-radius: 4px; font-weight: 900; letter-spacing: 0.08em;">
                  AO VIVO
                </span>
                <span>{item}</span>
                <span style="color: var(--acid); font-size: 0.6rem;">◆</span>
              </span>
            ))
          }
        </div>
      </div>
    </div>

    <!-- HUB HEADER -->
    <HubHeader />

    <section class="home-hero home-hero--catalog" aria-labelledby="home-title">
      <div class="hero-acid-points" aria-hidden="true">
        <span class="hero-acid-point hero-acid-point--one"></span>
        <span class="hero-acid-point hero-acid-point--two"></span>
        <span class="hero-acid-point hero-acid-point--three"></span>
        <span class="hero-acid-stroke"></span>
      </div>
      <img
        class="hero-banner-image"
        src="/assets/banners/home/banner-site-services.gif"
        alt="Neo FlowOFF Agency - infraestrutura comercial com IA, CRM, WhatsApp Business e automação em Goiânia"
        width="1920"
        height="720"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
      <div class="hero-copy">
        <div class="hero-eyebrow">
          <span class="hero-status-dot" aria-hidden="true"></span>
          {uiTexts.header.eyebrow}
        </div>
        <div
          id="home-title"
          class="hero-title hero-title-logo"
          role="img"
          aria-label="NEØ FlowOFF"
        >
          <img
            src="/logo_transp.svg"
            alt="Logotipo Neo FlowOFF Agency - Infraestrutura de IA em Goiânia"
            width="656"
            height="72"
            loading="eager"
            decoding="async"
          />
        </div>
        <p class="hero-lead">{uiTexts.header.subtitle}</p>
        <div class="hero-actions">
          <a class="neo-button neo-button--primary" href="#solucoes">
            {uiTexts.header.primary_cta}
          </a>
          <a
            class="neo-button neo-button--secondary"
            href="https://wa.me/556282705594?text=Ol%C3%A1!%20Vim%20pelo%20site%20da%20NE%C3%98%20FlowOFF%20e%20gostaria%20de%20falar%20sobre%20minha%20opera%C3%A7%C3%A3o.%20[utm:home-hero]"
            target="_blank"
            rel="noopener noreferrer"
          >
            {uiTexts.header.secondary_cta}
          </a>
        </div>
      </div>
    </section>

    <div class="hero-bottom-bar" aria-hidden="true">
      <div class="hero-bottom-track">
        <span>AGENTES DE IA</span>
        <span>◆</span>
        <span>WHATSAPP BUSINESS</span>
        <span>CRM & AUTOMAÇÕES</span>
        <span>DADOS & DASHBOARDS</span>
        <span>LANDING PAGES</span>
        <span>META TECH PROVIDER</span>
      </div>
    </div>

    <!-- SOLUÇÕES (GRID) -->

    <div id="solucoes">
      <!-- ECOSSISTEMA & TECNOLOGIA META (Fundo Claro Full-Bleed do Topo ao Badge Meta com Bordas Inferiores Arredondadas) -->
      <section class="section section-band section-band--meta">
        <!-- CONTAINER INTERNO ALINHADO AO MOBILE -->
        <div class="section-inner">
          <div class="section-heading meta-section-heading">
            <!-- CRISP ULTRA-CLEAN GLASS CAPSULE BADGE -->
            <div class="section-kicker section-kicker--meta">
              <span class="meta-dot" aria-hidden="true"></span>
              <span>ECOSSISTEMA & TECNOLOGIA META</span>
            </div>

            <p class="section-copy">
              Infraestrutura oficial da Meta para WhatsApp, APIs, webhooks e
              Meta Ads com Conversions API (CAPI).
            </p>
          </div>
          <div class="link-grid meta-link-grid">
            {
              metaProdutos.map((produto) => (
                <ProductCard
                  id={produto.id}
                  slug={produto.slug}
                  title={produto.title}
                  short_title={produto.short_title}
                  description={produto.description}
                  link={produto.link}
                  price={produto.price}
                  price_label={produto.price_label}
                  category={produto.category}
                  display_category={produto.display_category}
                  featured={produto.featured}
                  features={produto.features.slice(0, 4)}
                  forceGrid={true}
                />
              ))
            }

            <!-- CARD OFICIAL DO APP NEØFLW ENGINE:one -->
            <a href="/conectar-whatsapp/" class="lc lc--meta lc-engine-app">
              <div class="product-card-top">
                <div class="lc-icon">
                  <img
                    src="/assets/EngineOne.png"
                    alt="NEØFLW ENGINE:one - App Oficial Meta"
                    class="engine-app-logo-img"
                    width="32"
                    height="32"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <span class="engine-approved-pill">
                  <span class="engine-pulse-dot" aria-hidden="true"></span>
                  APP META APROVADO
                </span>
              </div>

              <div class="lc-body product-card-body product-card-body--stack">
                <div class="lc-title">NEØFLW ENGINE:one</div>
                <div class="lc-sub">App Oficial Homologado · Meta Tech Provider</div>
                <p class="lc-desc">
                  Aplicativo oficial aprovado pela Meta com renovação de acesso a dados concluída para WhatsApp Cloud API, webhooks e Login for Business.
                </p>
              </div>

              <div class="product-card-footer">
                <span class="card-action">
                  Conectar WhatsApp <i data-lucide="chevron-right"></i>
                </span>
              </div>
            </a>
          </div>

          <!-- BADGE META TECH PROVIDER -->
          <div class="partner-proof">
            <img
              src="/assets/badge_meta_tech_provider.webp"
              alt="Neo FlowOFF Agency - Meta Tech Provider para WhatsApp Business API"
              loading="lazy"
              decoding="async"
              width="1400"
              height="401"
            />
          </div>
        </div>
      </section>

      <!-- PLANOS (OPERAÇÕES CONECTADAS) -->
      <section class="section section-stack">
        <div class="section-heading section-heading--dark">
          <div class="section-label">{uiTexts.home.plans_label}</div>
          <p class="section-copy">{uiTexts.home.plans_description}</p>
        </div>
        <div class="link-grid">
          {
            planos.map((plano) => (
              <ProductCard
                id={plano.id}
                slug={plano.slug}
                title={plano.title}
                short_title={plano.short_title}
                description={plano.description}
                link={plano.link}
                price={plano.price}
                price_label={plano.price_label}
                category={plano.category}
                display_category={plano.display_category}
                featured={plano.featured}
                features={plano.features.slice(0, 4)}
              />
            ))
          }
        </div>
      </section>

      <!-- SERVIÇOS (IMPLEMENTAÇÕES À LA CARTE - SEÇÃO CLARA FULL-BLEED) -->
      <section class="section section-band">
        <div class="section-inner">
          <div class="section-heading">
            <div class="section-label section-label--light">
              {uiTexts.home.services_label}
            </div>
            <p class="section-copy">{uiTexts.home.services_description}</p>
          </div>
          <div class="link-grid">
            {
              servicos.map((servico) => (
                <ProductCard
                  id={servico.id}
                  slug={servico.slug}
                  title={servico.title}
                  short_title={servico.short_title}
                  description={servico.description}
                  link={servico.link}
                  price={servico.price}
                  price_label={servico.price_label}
                  category={servico.category}
                  display_category={servico.display_category}
                  featured={servico.featured}
                  features={servico.features.slice(0, 3)}
                  isLightSection={true}
                />
              ))
            }
          </div>

          <div class="services-hub-link-wrapper" style="margin-top: 2.75rem; text-align: center; display: flex; justify-content: center;">
            <a href="/servicos/" class="neo-button neo-button--dark" style="padding: 0.95rem 1.85rem; font-weight: 900; font-size: 0.88rem; letter-spacing: 0.04em; display: inline-flex; align-items: center; gap: 0.6rem;">
              <span>Ver Todos os Serviços &amp; Diagnósticos</span>
              <i data-lucide="arrow-right" aria-hidden="true"></i>
            </a>
          </div>
        </div>
      </section>
    </div>

    <!-- SEÇÃO MÉTODO (SEÇÃO ESCURA NO BG #272727) -->
    <section id="metodo" class="method-section">
      <div class="section-label">{uiTexts.home.method.eyebrow}</div>
      <h2>
        {uiTexts.home.method.title}
      </h2>

      <div class="method-grid">
        {
          uiTexts.home.method.steps.map((step, index) => {
            const stepIcons = ['search', 'layers', 'zap', 'activity'];
            return (
              <div class="method-card">
                <div class="method-card-head">
                  <span>0{index + 1}</span>
                  <i data-lucide={stepIcons[index] || 'zap'} />
                </div>
                <h3>{step.title}</h3>
                <p>{step.description}</p>
              </div>
            );
          })
        }
      </div>
      <p class="method-summary">{uiTexts.header.body}</p>
    </section>

    <!-- SEÇÃO CLOSING (SEÇÃO CLARA FULL-BLEED) -->
    <section class="section section-band about-band">
      <div class="about-inner">
        <!-- CLOSING / CTA FINAL -->
        <div class="closing-block">
          <div class="closing-kicker">
            <span>{uiTexts.home.closing.eyebrow}</span>
          </div>

          <h2>
            {uiTexts.home.closing.title}
          </h2>

          <p>
            {uiTexts.home.closing.body}
          </p>

          <div class="closing-actions">
            <a
              href="https://wa.me/556282705594?text=Ol%C3%A1!%20Gostaria%20de%20mapear%20a%20opera%C3%A7%C3%A3o%20comercial%20da%20minha%20empresa.%20[utm:home-closing]"
              target="_blank"
              rel="noopener noreferrer"
              class="neo-button neo-button--dark"
            >
              <i data-lucide="message-square"></i>
              {uiTexts.home.closing.primary_cta}
            </a>
          </div>
        </div>
      </div>
    </section>

    <BrandFooter />
  </div>

  <script>
    /* "EM BREVE" toast on soon element tap */
    document.querySelectorAll<HTMLElement>('.section-soon').forEach((el) => {
      el.addEventListener('click', (e: MouseEvent) => {
        const existing = document.querySelector('.soon-toast');
        if (existing) existing.remove();
        const toast = document.createElement('div');
        toast.className = 'soon-toast';
        toast.style.left = `${e.clientX}px`;
        toast.style.top = `${e.clientY}px`;
        toast.textContent = 'EM BREVE';
        document.body.appendChild(toast);
        setTimeout(() => toast.remove(), 1300);
      });
    });
  </script>
</Base>

<style>
  .engine-app-logo-img {
    width: 32px;
    height: 32px;
    object-fit: contain;
    border-radius: 6px;
    filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.4));
  }

  .engine-approved-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--mono);
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #4ade80;
    background: rgba(74, 222, 128, 0.1);
    border: 1px solid rgba(74, 222, 128, 0.25);
    padding: 0.25rem 0.55rem;
    border-radius: 0.35rem;
  }

  .engine-pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #4ade80;
    box-shadow: 0 0 8px #4ade80;
  }
</style>
