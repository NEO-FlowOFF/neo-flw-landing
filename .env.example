# ===========================================
# neoflowoff.agency Landing - Environment Variables
# ===========================================

# --------------------------------------------
# FlowPay / Woovi Gateway (PIX Payment)
# --------------------------------------------
# Woovi API Configuration
WOOVI_API_KEY=your_woovi_api_key_here
WOOVI_WEBHOOK_SECRET=your_woovi_webhook_secret_here
WOOVI_API_URL=https://api.woovi.com

# FlowPay API Configuration
FLOWPAY_API_URL=https://api.flowpay.cash
# Chave interna service-to-service da FlowPay Edge
FLOWPAY_INTERNAL_API_KEY=your_flowpay_internal_api_key_here
# Compatibilidade legada: fallback caso o deploy ainda use esse nome
FLOWPAY_API_KEY=your_flowpay_api_key_here
FLOWPAY_SIGNATURE_SECRET=your_flowpay_signature_secret_here

# Legacy OpenPix (compatibilidade)
OPENPIX_API_KEY=your_openpix_api_key_here

# --------------------------------------------
# Analytics & Tracking
# --------------------------------------------
# Google Tag Manager ID
GTM_ID=GTM-XXXXXXX

# Google Analytics 4 Measurement ID
GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Merchant Center ID
GOOGLE_MERCHANT_CENTER_ID=your_merchant_id_here

# Meta Pixel ID Principal
META_PIXEL_ID=xxxx

# --------------------------------------------
# WhatsApp Integration
# --------------------------------------------
# Número principal de contato (formato: +556294789032)
WHATSAPP_CONTACT=+556294789032

# --------------------------------------------
# Email & Notifications
# --------------------------------------------
# Email principal para contato LGPD
CONTACT_EMAIL=neo@neoprotocol.space

# SMTP Config (se houver envio de emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@domain.com
SMTP_PASSWORD=your_smtp_password

# Resend (email transacional de confirmacao de pagamento)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=NEO FlowOFF <pagamentos@neoflowoff.agency>
RESEND_TEMPLATE_ID=pagamento-confirmado

# --------------------------------------------
# AI Services
# --------------------------------------------
# Anthropic (Claude AI)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ASI1AI API Key
ASI1AI_API_KEY=your_asi1ai_api_key_here

# --------------------------------------------
# IPFS / Pinata
# --------------------------------------------
PINATA_API_KEY=your_pinata_api_key_here
PINATA_SECRET_API_KEY=your_pinata_secret_key_here
PINATA_JWT_SECRET=your_pinata_jwt_secret_here
PINATA_GATEWAY_URL=https://your-gateway.mypinata.cloud

# --------------------------------------------
# Lighthouse (IPFS Alternative)
# --------------------------------------------
LIGHTHOUSE_API_KEY=your_lighthouse_api_key_here

# --------------------------------------------
# NEO Protocol
# --------------------------------------------
# Skills Registry Index CID (IPFS)
NEO_INDEX_CID=your_neo_index_cid_here

# --------------------------------------------
# Site Configuration
# --------------------------------------------
# Site URL (para Open Graph, Canonical URLs, etc)
SITE_URL=https://lp.neoflowoff.agency

# Deploy Environment
NODE_ENV=development

# --------------------------------------------
# Security
# --------------------------------------------
# CORS Allowed Origins (separados por vírgula)
CORS_ORIGINS=https://lp.neoflowoff.agency,https://neoflowoff.agency,https://www.neoflowoff.agency,http://localhost:3000

# --------------------------------------------
# Feature Flags
# --------------------------------------------
# Habilitar FlowPay checkout
ENABLE_FLOWPAY=true

# Habilitar modo debug
DEBUG_MODE=false

# Meta Webhook Verification Token
META_VERIFY_TOKEN=your_meta_verify_token_here

# Meta Conversions API (CAPI) & Routing
META_ACCESS_TOKEN=your_meta_access_token_here
META_TEST_EVENT_CODE=your_test_event_code_here
ADS_ENGINEER_IP=127.0.0.1:3000

# --------------------------------------------
# Google Cloud Platform (GCP) / AI Factory
# --------------------------------------------
GCP_PROJECT_ID=your_gcp_project_id_here
GCP_SERVICE_ACCOUNT_KEY=your_gcp_service_account_json_base64_or_path
