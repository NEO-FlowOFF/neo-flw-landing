---
import { Image } from 'astro:assets';
import metaBadge from '../../assets/images/badge_meta_tech_provider.webp';
import catalogData from '../../data/catalog.json';
import uiTexts from '../../data/ui_texts.json';
import Base from '../../layouts/Base.astro';

export function getStaticPaths() {
  const planos = catalogData.products.filter(p => p.category === 'Plano');
  return planos.map(plano => ({
    params: { slug: plano.slug },
    props: { plano },
  }));
}

const { plano } = Astro.props;
---
<Base title={`${plano.title} | neoflowoff.agency`} description={plano.description}>
  <div class="page" style="max-width: 900px; margin: 0 auto; padding: 2rem 1.5rem;">
    <header style="margin-bottom: 2rem;">
      <a href="/" style="color: var(--text-2); text-decoration: none; font-size: 0.9rem; display: flex; align-items: center; gap: 8px;">
        <i data-lucide="chevron-left" style="width: 16px; height: 16px;"></i> {uiTexts.product_page.back_button}
      </a>
    </header>

    <div class="lc lc-featured" style="margin-bottom: 3rem; padding: 2.5rem;">
      <div class="lc-body">
        {plano.featured && (
          <div style="background: var(--pink-s); color: #fff; font-family: var(--mono); font-size: 0.75rem; font-weight: 700; padding: 4px 10px; border-radius: 4px; display: inline-block; margin-bottom: 0.8rem; text-transform: uppercase;">
            OPERAÇÃO PRINCIPAL
          </div>
        )}
        <div class="section-label" style="margin-bottom: 0.5rem;">{plano.display_category || uiTexts.product_page.plan_label}</div>
        <h1 class="lc-title" style="font-size: 2.5rem; margin-bottom: 1rem; font-weight: 900; line-height: 1.2;">{plano.title}</h1>
        
        <div class="lc-price" style="font-size: 2.2rem; margin-bottom: 1rem;">
          {plano.price_label && <span style="font-size: 0.9rem; color: var(--text-2); display: block; font-weight: 400;">{plano.price_label}</span>}
          R$ {plano.price.value.toLocaleString('pt-BR', { minimumFractionDigits: 2 })}
        </div>
        <p class="lc-desc" style="font-size: 1.1rem; line-height: 1.6;">{plano.description}</p>
      </div>
    </div>

    <!-- ESCOPO DA IMPLANTAÇÃO -->
    <section class="section" style="margin-bottom: 3rem;">
      <div class="section-label" style="margin-bottom: 1rem;">{uiTexts.product_page.included_features_label}</div>
      <ul style="list-style: none; padding: 0;">
        {plano.features.map(feature => (
          <li style="display: flex; gap: 12px; align-items: flex-start; margin-bottom: 1rem; color: var(--text); font-size: 1.05rem; line-height: 1.5;">
            <i data-lucide="check-circle" style="color: var(--acqua); width: 20px; height: 20px; flex-shrink: 0; margin-top: 2px;"></i>
            <span>{feature}</span>
          </li>
        ))}
      </ul>
    </section>

    <!-- O QUE ESTA CAMADA ORGANIZA (OUTCOMES) -->
    {plano.outcomes && (
      <section class="section" style="margin-bottom: 3rem; padding: 2rem; background: rgba(255, 255, 255, 0.02); border: 1px solid var(--border); border-radius: 8px;">
        <div class="section-label" style="margin-bottom: 1rem;">{uiTexts.product_page.outcomes_label}</div>
        <ul style="list-style: none; padding: 0;">
          {plano.outcomes.map(outcome => (
            <li style="display: flex; gap: 12px; align-items: flex-start; margin-bottom: 0.8rem; color: var(--text); font-size: 1rem; line-height: 1.5;">
              <i data-lucide="sparkles" style="color: var(--pink-s); width: 18px; height: 18px; flex-shrink: 0; margin-top: 2px;"></i>
              <span>{outcome}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- AVISO DE PRECIFICAÇÃO E AÇÕES -->
    <div style="margin-top: 3rem; text-align: center;">
      <p style="color: var(--text-2); font-size: 0.85rem; margin-bottom: 1.5rem; max-width: 600px; margin-left: auto; margin-right: auto; line-height: 1.5;">
        {uiTexts.product_page.pricing_notice}
      </p>

      <div style="display: flex; gap: 1rem; flex-direction: column; max-width: 500px; margin: 0 auto;">
        <button class="lc" style="width: 100%; display: inline-flex; align-items: center; justify-content: center; gap: 12px; font-size: 1.1rem; font-weight: 700; background: var(--pink-s); color: #fff; padding: 1.2rem; border-radius: 6px;">
          <i data-lucide="credit-card"></i> {uiTexts.product_page.checkout_button}
        </button>

        <a href={`https://wa.me/556294789032?text=Olá!%20Gostaria%20de%20validar%20o%20escopo%20do%20plano%20${encodeURIComponent(plano.title)}`} target="_blank" rel="noopener noreferrer" class="lc" style="width: 100%; display: inline-flex; align-items: center; justify-content: center; gap: 10px; font-size: 1rem; background: transparent; border: 1px solid var(--border); color: var(--text); padding: 1rem; text-decoration: none; border-radius: 6px;">
          <i data-lucide="message-circle" style="color: var(--acqua);"></i> {uiTexts.product_page.contact_button}
        </a>
      </div>
    </div>

    <!-- FOOTER -->
    <footer class="hub-footer" style="display: flex; flex-direction: column; align-items: center; gap: 1.5rem; margin-top: 5rem; padding-bottom: 3rem; text-align: center;">
      <div class="hub-footer-brand" style="font-size: 1.2rem; font-weight: 900;">
        <span class="neo">»</span>
        {uiTexts.footer.brand_name}
      </div>
      <p style="color: var(--text-2); font-size: 0.85rem; margin: 0;">
        {uiTexts.footer.tagline}
      </p>
      <Image src={metaBadge} alt="Meta Tech Provider" style="height: 40px; width: auto; object-fit: contain; opacity: 0.8;" />
    </footer>
  </div>
</Base>
