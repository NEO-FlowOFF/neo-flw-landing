---
interface Props {
  anchorBase?: string;
  homeHref?: string;
}

const { anchorBase = '', homeHref = '#' } = Astro.props;
const solutionsHref = `${anchorBase}#solucoes`;
const aboutHref = `${anchorBase}#sobre`;
---
<header class="hub-header">
  <!-- FLOATING STICKY GLASSBAR -->
  <div class="glass-navbar">
    <a href={homeHref} class="nav-brand">
      <img
        src="/assets/neoflowoff-logo-192.webp"
        srcset="/assets/neoflowoff-logo-192.webp 192w, /assets/neoflowoff-logo-384.webp 384w"
        sizes="136px"
        alt="Logotipo Neo FlowOFF Agency - Infraestrutura de IA em Goiânia"
        class="nav-logo"
        width="192"
        height="34"
        fetchpriority="high"
        loading="eager"
        decoding="async"
      />
    </a>

    <div class="nav-right">
      <button id="menu-toggle" class="hamburger-btn" aria-label="Abrir menu" aria-expanded="false" aria-controls="mobile-menu">
        <i data-lucide="menu" id="menu-icon-open" class="menu-toggle-icon"></i>
        <i data-lucide="x" id="menu-icon-close" class="menu-toggle-icon"></i>
      </button>
    </div>
  </div>

  <!-- GLASSMORPHIC HAMBURGER DROPDOWN MENU -->
  <div id="mobile-menu" class="glass-menu">
    <div class="menu-head">
      <span>Menu</span>
      <span>neoflowoff.agency</span>
    </div>
    <nav class="menu-nav">
      <a href={homeHref} class="menu-item">
        <span class="menu-icon"><i data-lucide="home"></i></span>
        <span class="menu-copy">
          <span>Início</span>
          <small>Visão geral</small>
        </span>
      </a>
      <a href={solutionsHref} class="menu-item">
        <span class="menu-icon"><i data-lucide="grid"></i></span>
        <span class="menu-copy">
          <span>Soluções & Implementações</span>
          <small>Planos e serviços</small>
        </span>
      </a>
      <a href={aboutHref} class="menu-item">
        <span class="menu-icon"><i data-lucide="shield"></i></span>
        <span class="menu-copy">
          <span>Sobre a Agência</span>
          <small>Arquitetura e método</small>
        </span>
      </a>
      <a href="https://wa.me/556294789032" target="_blank" rel="noopener noreferrer" class="menu-item cta-item">
        <span class="menu-icon"><i data-lucide="message-circle"></i></span>
        <span class="menu-copy">
          <span>Atendimento WhatsApp</span>
          <small>Mapear operação</small>
        </span>
      </a>
    </nav>
  </div>
</header>
<div id="menu-backdrop" class="menu-backdrop"></div>

<style>
  .hub-header {
    position: sticky;
    top: max(10px, env(safe-area-inset-top));
    z-index: 100;
    margin-bottom: 1rem;
    width: 100%;
  }

  /* FLOATING GLASSBAR */
  .glass-navbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.55rem 0.95rem;
    background: rgba(20, 22, 20, 0.72);
    backdrop-filter: blur(18px) saturate(150%);
    -webkit-backdrop-filter: blur(18px) saturate(150%);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 999px;
    box-shadow: 0 18px 44px rgba(0, 0, 0, 0.28), inset 0 1px 0 rgba(255, 255, 255, 0.12);
    position: relative;
    z-index: 2;
  }

  .nav-brand {
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  .nav-logo {
    height: 24px;
    width: auto;
    object-fit: contain;
    filter: drop-shadow(0 0 8px rgba(143, 254, 9, 0.18));
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .header-status {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 3px 9px;
    border-radius: 999px;
    background: rgba(143, 254, 9, 0.1);
    border: 1px solid rgba(143, 254, 9, 0.3);
  }

  .status-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--acid);
    box-shadow: 0 0 6px var(--acid);
    animation: status-pulse 1.8s infinite ease-in-out;
  }

  .status-text {
    font-family: var(--mono);
    font-size: 0.6rem;
    font-weight: 700;
    color: var(--acid);
    letter-spacing: 0.05em;
  }

  .hamburger-btn {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.13), rgba(255, 255, 255, 0.04));
    border: 1px solid rgba(143, 254, 9, 0.22);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.26), inset 0 1px 0 rgba(255, 255, 255, 0.12);
    position: relative;
    transition: background 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease, transform 0.15s ease;
  }

  .hamburger-btn::before {
    content: '';
    position: absolute;
    inset: -5px;
    border-radius: inherit;
    background: radial-gradient(circle, rgba(143, 254, 9, 0.18), transparent 64%);
    opacity: 0;
    transition: opacity 0.2s ease;
    z-index: -1;
  }

  .menu-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(8px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.22s ease;
    z-index: 99;
  }

  .menu-backdrop.active {
    opacity: 1;
    pointer-events: auto;
  }

  .hamburger-btn:hover,
  .hamburger-btn:focus-visible,
  .hamburger-btn.is-open {
    background: rgba(143, 254, 9, 0.1);
    border-color: rgba(143, 254, 9, 0.44);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.34), 0 0 18px rgba(143, 254, 9, 0.12);
    outline: none;
  }

  .hamburger-btn:hover::before,
  .hamburger-btn:focus-visible::before,
  .hamburger-btn.is-open::before {
    opacity: 1;
  }

  .hamburger-btn:active {
    transform: scale(0.92);
  }

  .menu-toggle-icon {
    position: absolute;
    width: 18px;
    height: 18px;
    color: var(--acid);
    transition: opacity 0.18s ease, transform 0.18s ease;
  }

  #menu-icon-close {
    opacity: 0;
    transform: rotate(-45deg) scale(0.74);
  }

  .hamburger-btn.is-open #menu-icon-open {
    opacity: 0;
    transform: rotate(45deg) scale(0.74);
  }

  .hamburger-btn.is-open #menu-icon-close {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }

  /* GLASSMORPHIC DROPDOWN MENU */
  .glass-menu {
    position: absolute;
    top: calc(100% + 10px);
    left: 0;
    right: 0;
    overflow: hidden;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.075), rgba(255, 255, 255, 0.025)),
      rgba(12, 12, 15, 0.94);
    backdrop-filter: blur(28px) saturate(170%);
    -webkit-backdrop-filter: blur(28px) saturate(170%);
    border: 1px solid rgba(143, 254, 9, 0.2);
    border-radius: 22px;
    padding: 0.75rem;
    box-shadow: 0 24px 54px rgba(0, 0, 0, 0.48), 0 0 0 1px rgba(255, 255, 255, 0.035) inset;
    opacity: 0;
    transform: translateY(-12px) scale(0.98);
    pointer-events: none;
    transform-origin: top center;
    transition: opacity 0.22s ease, transform 0.28s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .glass-menu::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(120deg, rgba(143, 254, 9, 0.1), transparent 38%, rgba(255, 255, 255, 0.04));
    opacity: 0.75;
    pointer-events: none;
  }

  .menu-head,
  .menu-nav {
    position: relative;
    z-index: 1;
  }

  .glass-menu.active {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }

  .menu-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 0.2rem 0.25rem 0.7rem;
    font-family: var(--mono);
    font-size: 0.58rem;
    font-weight: 800;
    color: rgba(255, 255, 255, 0.72);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .menu-head span:last-child {
    color: rgba(143, 254, 9, 0.78);
    text-align: right;
  }

  .menu-nav {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .menu-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 58px;
    padding: 0.65rem 0.75rem;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.045);
    border: 1px solid rgba(255, 255, 255, 0.07);
    color: var(--text);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 700;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.045);
    transition: background 0.2s ease, border-color 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease;
  }

  .menu-item:hover,
  .menu-item:focus-visible {
    background: rgba(255, 255, 255, 0.075);
    border-color: rgba(143, 254, 9, 0.24);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.075), 0 8px 20px rgba(0, 0, 0, 0.24);
    outline: none;
  }

  .menu-icon {
    width: 32px;
    height: 32px;
    border-radius: 10px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--acid);
    background: rgba(143, 254, 9, 0.08);
    border: 1px solid rgba(143, 254, 9, 0.16);
    flex: 0 0 auto;
  }

  .menu-icon [data-lucide] {
    width: 16px;
    height: 16px;
  }

  .menu-copy {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.12rem;
    line-height: 1.15;
  }

  .menu-copy > span {
    overflow-wrap: anywhere;
  }

  .menu-copy small {
    font-family: var(--mono);
    font-size: 0.62rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.68);
  }

  .menu-item:active {
    transform: scale(0.98);
    background: rgba(255, 255, 255, 0.08);
  }

  .menu-item.cta-item {
    background: linear-gradient(135deg, var(--acid), #f0ff36);
    color: #0b0b0d;
    border: none;
    margin-top: 4px;
    font-weight: 800;
    box-shadow: 0 12px 26px rgba(143, 254, 9, 0.18);
  }

  .menu-item.cta-item .menu-icon {
    color: #0b0b0d;
    background: rgba(0, 0, 0, 0.12);
    border-color: rgba(0, 0, 0, 0.14);
  }

  .menu-item.cta-item .menu-copy small {
    color: rgba(11, 11, 13, 0.62);
  }

  @keyframes status-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.8); }
  }
</style>

<script>
  const toggleBtn = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  toggleBtn?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('active');
    toggleBtn.setAttribute('aria-expanded', String(Boolean(isOpen)));
    toggleBtn.classList.toggle('is-open', Boolean(isOpen));
    const backdrop = document.getElementById('menu-backdrop');
    if (backdrop) backdrop.classList.toggle('active', Boolean(isOpen));
  });

  document.querySelectorAll('.menu-item').forEach(item => {
    item.addEventListener('click', () => {
      menu?.classList.remove('active');
      toggleBtn?.setAttribute('aria-expanded', 'false');
      toggleBtn?.classList.remove('is-open');
      const backdrop = document.getElementById('menu-backdrop');
      if (backdrop) backdrop.classList.remove('active');
    });
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || !menu?.classList.contains('active')) return;
    menu.classList.remove('active');
    toggleBtn?.setAttribute('aria-expanded', 'false');
    toggleBtn?.classList.remove('is-open');
    const backdrop = document.getElementById('menu-backdrop');
    if (backdrop) backdrop.classList.remove('active');
    toggleBtn?.focus();
  });
</script>
