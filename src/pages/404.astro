---
import Base from '../layouts/Base.astro';
---

<Base title="Página não encontrada" description="Desculpe, a página que você procura não existe.">
  <section class="empty-state" aria-labelledby="not-found-title">
    <div class="empty-state-icon">
      <i data-lucide="search"></i>
    </div>
    <p class="empty-state-code">404</p>
    <h1 id="not-found-title">Página não encontrada</h1>
    <p>
      O conteúdo que você tentou acessar não foi encontrado. Talvez ele tenha sido removido ou o link está incorreto.
    </p>
    <a href="/" class="neo-button neo-button--primary">
      Voltar para a Home
    </a>
  </section>
</Base>
