---
import uiTexts from '../data/ui_texts.json';
import steelLogoImage from '../assets/images/steel_flw.webp';
---

<footer class="brand-footer">
  <img src={steelLogoImage.src} width={steelLogoImage.width} height={steelLogoImage.height} alt="Logotipo Neo FlowOFF Agency - infraestrutura comercial e IA" loading="lazy" decoding="async" />
  <p>
    {uiTexts.footer.tagline}
  </p>
  <div class="brand-footer-statement">
    {uiTexts.footer.statement}
  </div>

  <div class="brand-footer-links">
    <a href="/privacy" class="footer-governance-link">Política de Privacidade</a>
    <span aria-hidden="true">•</span>
    <a href="/terms" class="footer-governance-link">Termos de Serviço</a>
    <span aria-hidden="true">•</span>
    <a href="https://neoflowoff.agency/excluir-dados" class="footer-governance-link">Exclusão de Dados</a>
  </div>
  <p class="footer-legal-entity">
    <span>Flowoff Marketing e Assessoria Digital LTDA</span>
    <span class="footer-legal-nobreak">• CNPJ: 43.376.355/0001-92</span>
    <span class="footer-legal-nobreak">• neo@neoflowoff.agency</span>
  </p>
</footer>
