---
import Base from '../layouts/Base.astro';
import configData from '../data/config.json';
import brandLogo from '../assets/logos/neoflowoff-logo26-2.webp';
import '../styles/spinner.css';

const metaConfig = configData.integrations.meta;
const metaAppId = metaConfig.app_id;
const metaLoginConfigurationId = metaConfig.login_configuration_id;
const graphApiVersion = metaConfig.graph_api_version;
---

<Base title="Conectar WhatsApp Business | NEØ FlowOFF Meta Tech Provider" description="Conexão oficial da Neo FlowOFF Agency via Meta Cloud API para WhatsApp Business, Embedded Signup e infraestrutura comercial com IA.">
  <Fragment slot="head">
    <link rel="preload" as="image" href={brandLogo.src} fetchpriority="high" type="image/webp" />
  </Fragment>
  <div class="wa-page-wrapper">
    <div class="wa-page-container">
      <!-- HEADER COM LOGO DA AGÊNCIA (SEM MENU HAMBÚRGUER) -->
      <header class="clean-header">
        <div class="glass-navbar-simple">
          <a href="/" class="nav-brand">
            <span class="portal-brand-text">neoflowoff.portal</span>
          </a>
          <div class="header-status-badge">
            <span class="status-dot"></span>
            <span class="status-text">// NEØ GROWTH SYSTEM</span>
          </div>
        </div>
      </header>

      <!-- CARD MINIMALISTA E MODERNO -->
      <main class="wa-card">

        <!-- LOGO META TECH PROVIDER & APP ENGINE:ONE -->
        <div class="meta-brand-header">
          <div class="meta-app-badge-group">
            <img
              src="/assets/EngineOne.png"
              alt="NEØFLW ENGINE:one - Aplicativo Oficial Homologado na Meta"
              class="engine-badge-img"
              width="44"
              height="44"
              loading="eager"
            />
            <img
              src="/lgo-app-stell.png"
              alt="Neo FlowOFF Agency - aplicativo Meta Tech Provider para WhatsApp Business"
              class="meta-badge-img"
              width="78"
              height="39"
              loading="eager"
            />
          </div>
        </div>

        <!-- TAG MINIMALISTA -->
        <div class="meta-tag">
          <span class="pulse-dot"></span>
          <span>NEØFLW ENGINE:one · META BUSINESS MESSAGING</span>
        </div>

        <!-- TÍTULO & SUBTÍTULO -->
        <h1 class="wa-card-title">
        <img
          src={brandLogo.src}
          width={brandLogo.width}
          height={brandLogo.height}
          alt="Logotipo Neo FlowOFF Agency - WhatsApp Business API e automação comercial"
          class="card-brand-logo-img"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
        </h1>
        <!-- BLOCO 1: ACCESS GATE (BLOQUEIO POR PADRÃO) -->
        <div id="access-gate-block" class="access-gate-card">
          <div class="gate-status-pill">
            <span class="gate-status-dot"></span>
            <span>ACESSO RESTRITO · ATIVAÇÃO NECESSÁRIA</span>
          </div>

          <p class="gate-lead">
            A conexão de canais oficiais do WhatsApp Business via <strong>NEØFLW ENGINE:one</strong> é restrita a clientes com licença ativa ou ativação autorizada no NEØ Growth System.
          </p>

          <div class="gate-action-primary">
            <a
              href="https://app.flowpay.cash/checkout/8ab89a0712f3d6fb"
              target="_blank"
              rel="noopener noreferrer"
              class="gate-flowpay-btn"
            >
              <i data-lucide="credit-card"></i>
              <span>Adquirir Chave de Ativação via PIX (FlowPay)</span>
            </a>
            <a
              href="https://wa.me/556282705594?text=Ol%C3%A1!%20Gostaria%20de%20solicitar%20a%20chave%20de%20ativa%C3%A7%C3%A3o%20para%20conectar%20o%20WhatsApp%20Business.%20[utm:conectar-whatsapp-gate]"
              target="_blank"
              rel="noopener noreferrer"
              class="gate-whatsapp-btn"
            >
              <i data-lucide="message-circle"></i>
              <span>Solicitar Ativação com Especialista</span>
            </a>
          </div>

          <div class="gate-divider">
            <span>Já possui chave de ativação?</span>
          </div>

          <form id="gate-key-form" class="gate-form" onsubmit="return false;">
            <div class="gate-input-group">
              <input
                type="text"
                id="gate-access-key-input"
                class="gate-input"
                placeholder="Insira sua Chave (ex: flw_...)"
                autocomplete="off"
                required
              />
              <button type="submit" id="btn-unlock-gate" class="gate-btn-unlock">
                Desbloquear
              </button>
            </div>
            <div id="gate-key-error" class="validation-message" hidden></div>
          </form>
        </div>

        <!-- BLOCO 2: CONECTOR ATIVO (LIBERADO APÓS AUTORIZAÇÃO) -->
        <div id="connector-active-block" class="connector-active-block" hidden>
          <div class="auth-unlocked-banner">
            <span class="unlocked-dot"></span>
            <span class="unlocked-text">LICENÇA AUTORIZADA · CONECTOR LIBERADO</span>
            <button type="button" id="btn-lock-session" class="btn-lock-session" title="Encerrar Sessão">Bloquear</button>
          </div>

          <p class="wa-card-desc">
            Autorize os canais comerciais da sua empresa para integração com o <strong>NEØ Growth System</strong>.
          </p>

          <!-- INPUT DE NOME DE EXIBIÇÃO -->
          <div class="input-wrapper">
            <label for="display-name-input" class="input-label">Nome de Exibição do WhatsApp (Display Name)</label>
            <input
              type="text"
              id="display-name-input"
              class="input-display-name"
              placeholder="Ex: Flowoff Agency"
              autocomplete="off"
              required
            />
            <div id="validation-error" class="validation-message" hidden></div>
          </div>

          <!-- BOTÃO AZUL OFICIAL META -->
          <div class="cta-wrapper">
            <button
              id="btn-meta-signup"
              onclick="launchWhatsAppSignup()"
              class="btn-meta-blue"
              data-haptic
              data-meta-app-id={metaAppId}
              data-meta-config-id={metaLoginConfigurationId}
              data-graph-api-version={graphApiVersion}
              aria-label="Continuar com a Meta"
            >
              <svg class="meta-btn-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
              <span class="btn-text">Continuar com a Meta</span>
              <span class="btn-spinner-host" data-spinner-host aria-hidden="true"></span>
            </button>
          </div>

          <!-- CAIXA DE STATUS -->
          <div id="signup-status" class="status-box" hidden></div>
        </div>

        <!-- SELOS DE SEGURANÇA E CONEXÃO -->
        <div class="trust-grid">
          <div class="trust-card">
            <i data-lucide="shield-check" class="trust-icon"></i>
            <div>
              <strong>Autorização via Meta</strong>
              <small>Ambiente oficial de conexão</small>
            </div>
          </div>
          <div class="trust-card">
            <i data-lucide="zap" class="trust-icon"></i>
            <div>
              <strong>Orquestração NEØ</strong>
              <small>Integração com o Growth System</small>
            </div>
          </div>
        </div>

        <!-- CONTEÚDO INFORMATIVO OFICIAL SSR -->
        <section class="wa-ssr-info" aria-label="Especificações de Conexão">
          <h2 class="ssr-info-title">Especificações de Conexão</h2>
          <div class="ssr-spec-grid">
            <div class="ssr-spec-item">
              <span class="ssr-spec-label">Aplicação</span>
              <span class="ssr-spec-value">NEØFLW ENGINE:one</span>
            </div>
            <div class="ssr-spec-item">
              <span class="ssr-spec-label">App ID</span>
              <span class="ssr-spec-value">1500002841696407</span>
            </div>
            <div class="ssr-spec-item">
              <span class="ssr-spec-label">Tecnologia</span>
              <span class="ssr-spec-value">Meta Business Messaging</span>
            </div>
            <div class="ssr-spec-item">
              <span class="ssr-spec-label">Provedor</span>
              <span class="ssr-spec-value">Tech Provider</span>
            </div>
            <div class="ssr-spec-item">
              <span class="ssr-spec-label">Versão da API</span>
              <span class="ssr-spec-value">Graph API v25.0</span>
            </div>
          </div>

          <div class="ssr-explanation">
            <p>
              Empresas clientes conectam seus próprios ativos Meta de forma direta. O fluxo utiliza a tecnologia oficial <strong>Embedded Signup</strong>, garantindo que códigos de autenticação e tokens de acesso sejam processados exclusivamente no ambiente seguro do backend, sem nunca expor credenciais sensíveis no navegador.
            </p>
            <p>
              As permissões concedidas são utilizadas estritamente para a configuração inicial, gestão técnica e envio autorizado de mensagens transacionais e comerciais através da <strong>WhatsApp Business Platform</strong>.
            </p>
          </div>
        </section>

        <!-- FOOTER INFO DO APP -->
        <footer class="app-info-footer">
          <span>NEØFLW ENGINE:one</span>
          <span>·</span>
          <span><code>{metaAppId}</code></span>
        </footer>
      </main>

      <!-- FOOTER DE CONFORMIDADE -->
      <nav class="compliance-footer" aria-label="Links de conformidade">
        <a href="/privacy" class="compliance-link">Política de Privacidade</a>
        <span class="compliance-sep" aria-hidden="true">•</span>
        <a href="/terms" class="compliance-link">Termos de Serviço</a>
        <span class="compliance-sep" aria-hidden="true">•</span>
        <a href="/excluir-dados" class="compliance-link">Exclusão de Dados</a>
      </nav>
    </div>
  </div>

  <style>
    /* ─── PÁGINA ─── */
    .wa-page-wrapper {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 0.5rem 1rem 4rem;
      position: relative;
      isolation: isolate;
    }

    /* Glow ambiente no fundo */
    .wa-page-wrapper::before {
      content: '';
      position: fixed;
      inset: 0;
      background:
        radial-gradient(ellipse 70% 55% at 50% -10%, rgba(24, 119, 242, 0.14) 0%, transparent 65%),
        radial-gradient(ellipse 50% 40% at 80% 90%, rgba(143, 254, 9, 0.06) 0%, transparent 60%);
      pointer-events: none;
      z-index: -1;
    }

    .wa-page-container {
      width: 100%;
      max-width: 440px;
      margin: 0 auto;
    }

    /* ─── HEADER ─── */
    .clean-header {
      position: sticky;
      top: 12px;
      z-index: 100;
      margin-bottom: 2rem;
      width: 100%;
      animation: fadeUp 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    .glass-navbar-simple {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.6rem 1.1rem;
      background: rgba(23, 24, 23, 0.82);
      backdrop-filter: blur(20px) saturate(200%);
      -webkit-backdrop-filter: blur(20px) saturate(200%);
      border: 1px solid rgba(255, 255, 255, 0.09);
      border-radius: 999px;
      box-shadow:
        0 4px 24px rgba(0, 0, 0, 0.55),
        0 1px 0 rgba(255, 255, 255, 0.06) inset;
    }

    .nav-brand {
      display: flex;
      align-items: center;
      gap: 8px;
      text-decoration: none;
    }

    .portal-brand-text {
      color: rgba(255, 255, 255, 0.6);
      font-size: 0.85rem;
      font-weight: 500;
      letter-spacing: 0.01em;
    }

    .header-status-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 11px;
      border-radius: 999px;
      background: rgba(143, 254, 9, 0.07);
      border: 1px solid rgba(143, 254, 9, 0.22);
    }

    .status-dot {
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background: var(--acid);
      box-shadow: 0 0 7px var(--acid);
      animation: blink 2.4s ease-in-out infinite;
    }

    .status-text {
      font-family: var(--mono);
      font-size: 0.59rem;
      font-weight: 700;
      color: var(--acid);
      letter-spacing: 0.07em;
      opacity: 0.85;
    }

    /* ─── CARD PRINCIPAL ─── */
    .wa-card {
      position: relative;
      /* borda gradiente via pseudo-element */
      background: linear-gradient(165deg, rgba(26, 26, 34, 0.97) 0%, rgba(10, 10, 14, 0.99) 100%);
      border-radius: 12px;
      padding: 2.6rem 2.2rem 2rem;
      text-align: center;
      overflow: hidden;
      contain: layout paint;
      animation: fadeUp 0.55s 0.08s cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    /* Borda com gradiente sutil */
    .wa-card::before {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: 12px;
      padding: 1px;
      background: linear-gradient(
        160deg,
        rgba(255, 255, 255, 0.16) 0%,
        rgba(255, 255, 255, 0.04) 40%,
        rgba(24, 119, 242, 0.18) 100%
      );
      -webkit-mask:
        linear-gradient(#fff 0 0) content-box,
        linear-gradient(#fff 0 0);
      -webkit-mask-composite: xor;
      mask-composite: exclude;
      pointer-events: none;
    }

    /* Profundidade + glow azul no topo */
    .wa-card::after {
      content: '';
      position: absolute;
      top: -80px;
      left: 50%;
      transform: translateX(-50%);
      width: 320px;
      height: 320px;
      background: radial-gradient(circle, rgba(24, 119, 242, 0.18) 0%, transparent 68%);
      pointer-events: none;
      filter: blur(20px);
    }

    /* ─── LOGO APP / META ─── */
    .meta-brand-header {
      display: flex;
      justify-content: center;
      margin-bottom: 1.3rem;
      position: relative;
      z-index: 1;
    }

    .meta-app-badge-group {
      display: inline-flex;
      align-items: center;
      gap: 12px;
    }

    .engine-badge-img {
      width: 38px;
      height: 38px;
      object-fit: contain;
      border-radius: 8px;
      filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.5));
    }

    .meta-badge-img {
      max-width: 120px;
      width: 100%;
      height: auto;
      object-fit: contain;
      filter: drop-shadow(0 0 12px rgba(24, 119, 242, 0.5));
    }

    /* ─── TAG CONNECTOR ─── */
    .meta-tag {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      font-family: var(--mono);
      font-size: 0.62rem;
      font-weight: 800;
      letter-spacing: 0.09em;
      color: #4fa3ff;
      background: rgba(24, 119, 242, 0.1);
      padding: 5px 15px;
      border-radius: 999px;
      border: 1px solid rgba(24, 119, 242, 0.28);
      margin-bottom: 1.4rem;
      position: relative;
      z-index: 1;
    }

    .pulse-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #1877F2;
      box-shadow: 0 0 8px #1877F2;
      animation: blink 2s infinite ease-in-out;
    }

    /* ─── TÍTULO / LOGO MARCA ─── */
    .wa-card-title {
      font-size: 1.5rem;
      font-weight: 900;
      color: #ffffff;
      margin-bottom: 0.7rem;
      text-transform: uppercase;
      letter-spacing: -0.01em;
      line-height: 1.2;
      position: relative;
      z-index: 1;
    }

    .card-brand-logo-img {
      max-width: 210px;
      width: 100%;
      height: auto;
      object-fit: contain;
      filter:
        drop-shadow(0 0 18px rgba(143, 254, 9, 0.24))
        drop-shadow(0 2px 8px rgba(0, 0, 0, 0.6));
      margin: 0.2rem auto 0.5rem;
      display: block;
    }

    .wa-card-desc {
      color: rgba(255, 255, 255, 0.58);
      font-size: 0.875rem;
      line-height: 1.6;
      margin-bottom: 2rem;
      position: relative;
      z-index: 1;
      max-width: 320px;
      margin-left: auto;
      margin-right: auto;
    }

    /* ─── INPUT DE DISPLAY NAME ─── */
    .input-wrapper {
      margin-bottom: 1.8rem;
      text-align: left;
      position: relative;
      z-index: 1;
      max-width: 320px;
      margin-left: auto;
      margin-right: auto;
    }

    .input-label {
      display: block;
      font-size: 0.73rem;
      font-weight: 700;
      color: rgba(255, 255, 255, 0.5);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 0.5rem;
    }

    .input-display-name {
      width: 100%;
      background: rgba(14, 15, 14, 0.95);
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 10px;
      padding: 12px 14px;
      color: #ffffff;
      font-size: 0.9rem;
      outline: none;
      transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .input-display-name:focus {
      border-color: rgba(24, 119, 242, 0.5);
      box-shadow: 0 0 0 2px rgba(24, 119, 242, 0.18);
    }

    .validation-message {
      font-size: 0.75rem;
      color: #ff5252;
      margin-top: 0.5rem;
      line-height: 1.4;
      font-weight: 500;
    }

    /* ─── BOTÃO META ─── */
    .cta-wrapper {
      margin-bottom: 1.4rem;
      position: relative;
      z-index: 1;
    }

    .btn-meta-blue {
      width: 100%;
      background: linear-gradient(180deg, #2385ff 0%, #1877F2 55%, #1464d8 100%);
      color: #ffffff;
      border: none;
      padding: 17px 24px;
      font-size: 0.96rem;
      font-weight: 700;
      letter-spacing: 0.01em;
      border-radius: 14px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      box-shadow:
        0 1px 0 rgba(255, 255, 255, 0.22) inset,
        0 -1px 0 rgba(0, 0, 0, 0.25) inset,
        0 8px 24px rgba(24, 119, 242, 0.42),
        0 2px 6px rgba(24, 119, 242, 0.28);
      transition: transform 0.2s ease, box-shadow 0.2s ease, filter 0.2s ease;
      position: relative;
      overflow: hidden;
    }

    /* shimmer no hover */
    .btn-meta-blue::after {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 60%;
      height: 100%;
      background: linear-gradient(
        105deg,
        transparent 20%,
        rgba(255, 255, 255, 0.12) 50%,
        transparent 80%
      );
      transition: left 0.45s ease;
    }

    .btn-meta-blue:hover:not(:disabled)::after {
      left: 160%;
    }

    .btn-meta-blue:hover:not(:disabled) {
      transform: translateY(-2px);
      box-shadow:
        0 1px 0 rgba(255, 255, 255, 0.22) inset,
        0 -1px 0 rgba(0, 0, 0, 0.25) inset,
        0 14px 36px rgba(24, 119, 242, 0.52),
        0 4px 10px rgba(24, 119, 242, 0.3);
      filter: brightness(1.06);
    }

    .btn-meta-blue:active:not(:disabled) {
      transform: translateY(0) scale(0.98);
      box-shadow:
        0 1px 0 rgba(255, 255, 255, 0.18) inset,
        0 4px 12px rgba(24, 119, 242, 0.32);
      filter: brightness(0.96);
    }

    .btn-meta-blue:disabled {
      opacity: 0.55;
      cursor: not-allowed;
    }

    .meta-btn-icon {
      flex-shrink: 0;
      color: #ffffff;
    }

    .btn-spinner-host {
      display: inline-grid;
      place-items: center;
      width: 18px;
      height: 18px;
      flex-shrink: 0;
      visibility: hidden;
    }

    .btn-spinner-host.is-active {
      visibility: visible;
    }

    .btn-spinner-host .spinner {
      display: block;
    }

    /* ─── STATUS BOX ─── */
    .status-box {
      margin-top: 1rem;
      margin-bottom: 1.2rem;
      padding: 0.9rem 1.15rem;
      border-radius: 12px;
      font-family: var(--mono);
      font-size: 0.74rem;
      line-height: 1.5;
      text-align: left;
      border: 1px solid transparent;
      animation: fadeIn 0.25s ease both;
      position: relative;
      z-index: 1;
    }

    .status-box.info {
      background: rgba(24, 119, 242, 0.1);
      border-color: rgba(24, 119, 242, 0.3);
      color: #7bbfff;
    }

    .status-box.success {
      background: rgba(143, 254, 9, 0.1);
      border-color: rgba(143, 254, 9, 0.38);
      color: var(--acid);
    }

    .status-box.warning {
      background: rgba(255, 179, 0, 0.1);
      border-color: rgba(255, 179, 0, 0.35);
      color: #ffc940;
    }

    .status-box.error {
      background: rgba(255, 82, 82, 0.1);
      border-color: rgba(255, 82, 82, 0.35);
      color: #ff8585;
    }

    /* ─── TRUST GRID ─── */
    .trust-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
      margin-top: 1.4rem;
      padding-top: 1.4rem;
      border-top: 1px solid rgba(255, 255, 255, 0.06);
      text-align: left;
      position: relative;
      z-index: 1;
    }

    .trust-card {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid rgba(255, 255, 255, 0.055);
      border-radius: 14px;
      padding: 0.8rem 0.85rem;
      transition: border-color 0.2s ease, background 0.2s ease;
    }

    .trust-card:hover {
      background: rgba(255, 255, 255, 0.038);
      border-color: rgba(255, 255, 255, 0.1);
    }

    .trust-card strong {
      display: block;
      font-size: 0.73rem;
      color: rgba(255, 255, 255, 0.88);
      line-height: 1.25;
      font-weight: 600;
    }

    .trust-card small {
      display: block;
      font-size: 0.63rem;
      color: rgba(255, 255, 255, 0.42);
      margin-top: 3px;
      line-height: 1.4;
    }

    .trust-icon {
      width: 16px;
      height: 16px;
      color: var(--acid);
    }

    /* ─── FOOTER ─── */
    .app-info-footer {
      margin-top: 1.8rem;
      padding-top: 1.1rem;
      border-top: 1px solid rgba(255, 255, 255, 0.05);
      font-family: var(--mono);
      font-size: 0.63rem;
