---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import HubHeader from '../components/HubHeader.astro';
import catalogData from '../data/catalog.json';
import uiTexts from '../data/ui_texts.json';
import nodeneoImage from '../assets/images/nodeneo.webp';
import steelLogoImage from '../assets/images/steel_flw.webp';

const isMeta = (slug: string) => slug?.includes('meta') || slug?.includes('whatsapp');

const metaProdutos = catalogData.products.filter(p => isMeta(p.slug));
const planos = catalogData.products.filter(p => p.category === 'Plano' && !isMeta(p.slug));
const servicos = catalogData.products.filter(p => p.category === 'Serviço' && !isMeta(p.slug));
---
<Base>
  <div class="home-page">
    <!-- TOP TELENOTÍCIAS TICKER BAR (Mídia & Infraestrutura) -->
    <div class="top-telenoticias-bar" style="width: 100vw; position: relative; left: 50%; right: 50%; margin-left: -50vw; margin-right: -50vw; background: #0b0b0e; color: #ffffff; padding: 7px 0; border-bottom: 1px solid rgba(255, 255, 255, 0.12); overflow: hidden; z-index: 1000;">
      <div class="digital-ticker-portal" style="position: relative; width: 100%; overflow: hidden; -webkit-mask-image: linear-gradient(90deg, transparent 0px, transparent 1px, #000 2px, #000 calc(100% - 2px), transparent calc(100% - 1px), transparent 100%); mask-image: linear-gradient(90deg, transparent 0px, transparent 1px, #000 2px, #000 calc(100% - 2px), transparent calc(100% - 1px), transparent 100%);">
        <div class="ticker-track" style="display: flex; width: max-content; animation: ticker-loop 24s linear infinite; gap: 2.5rem;">
          <span style="font-family: var(--mono); font-size: 0.72rem; font-weight: 800; color: #ffffff; text-transform: uppercase; letter-spacing: 0.05em; white-space: nowrap; display: inline-flex; align-items: center; gap: 0.7rem;">
            <span style="background: var(--acid); color: #000; font-size: 0.58rem; padding: 2px 6px; border-radius: 4px; font-weight: 900; letter-spacing: 0.08em;">LATEST</span>
            <span>Agentes de IA, páginas, CRM e flows comerciais para empresas. Marketing com infraestrutura.</span>
            <span style="color: var(--acid); font-size: 0.6rem;">◆</span>
          </span>
          <span style="font-family: var(--mono); font-size: 0.72rem; font-weight: 800; color: #ffffff; text-transform: uppercase; letter-spacing: 0.05em; white-space: nowrap; display: inline-flex; align-items: center; gap: 0.7rem;">
            <span style="background: var(--acid); color: #000; font-size: 0.58rem; padding: 2px 6px; border-radius: 4px; font-weight: 900; letter-spacing: 0.08em;">LATEST</span>
            <span>Agentes de IA, páginas, CRM e flows comerciais para empresas. Marketing com infraestrutura.</span>
            <span style="color: var(--acid); font-size: 0.6rem;">◆</span>
          </span>
        </div>
      </div>
    </div>

    <!-- HUB HEADER -->
    <HubHeader />

    <section class="home-hero" aria-labelledby="home-title">
      <div class="hero-copy">
        <div class="hero-eyebrow">
          <span class="hero-status-dot" aria-hidden="true"></span>
          {uiTexts.header.eyebrow}
        </div>
        <div id="home-title" class="hero-title hero-title-logo" role="img" aria-label="NEØ FlowOFF">
          <img
            src="/logo_transp.png"
            alt="NEØ FlowOFF"
            width="2618"
            height="463"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </div>
        <p class="hero-lead">{uiTexts.header.subtitle}</p>
        <p class="hero-body">{uiTexts.header.body}</p>
        <div class="hero-actions">
          <a class="neo-button neo-button--primary" href="#solucoes">
            {uiTexts.header.primary_cta}
          </a>
          <a class="neo-button neo-button--secondary" href="https://wa.me/556294789032" target="_blank" rel="noopener noreferrer">
            {uiTexts.header.secondary_cta}
          </a>
        </div>
      </div>

    </section>

    <!-- SOLUÇÕES (GRID) -->
    <div id="solucoes">
      <!-- ECOSSISTEMA & TECNOLOGIA META (Fundo Claro Full-Bleed do Topo ao Badge Meta com Bordas Inferiores Arredondadas) -->
      <section class="section section-band section-band--meta">
        <!-- CONTAINER INTERNO ALINHADO AO MOBILE -->
        <div class="section-inner">

          <div class="section-heading meta-section-heading">
            <!-- CRISP ULTRA-CLEAN GLASS CAPSULE BADGE -->
            <div class="section-kicker section-kicker--meta">
              <span class="meta-dot" aria-hidden="true"></span>
              <span>ECOSSISTEMA & TECNOLOGIA META</span>
            </div>

            <p class="section-copy">Infraestrutura oficial da Meta para WhatsApp, APIs, webhooks e Meta Ads com Conversions API (CAPI).</p>
          </div>
          <div class="link-grid meta-link-grid">
            {metaProdutos.map((produto) => (
              <ProductCard
                id={produto.id}
                slug={produto.slug}
                title={produto.title}
                short_title={produto.short_title}
                description={produto.description}
                link={produto.link}
                price={produto.price}
                price_label={produto.price_label}
                category={produto.category}
                display_category={produto.display_category}
                featured={produto.featured}
                features={produto.features.slice(0, 4)}
                forceGrid={true}
              />
            ))}
          </div>

          <!-- BADGE META TECH PROVIDER -->
          <div class="partner-proof">
            <img
              src="/assets/badge_meta_tech_provider.webp"
              alt="Meta Tech Provider — Official Partner"
              loading="lazy"
              decoding="async"
              width="1400"
              height="401"
            />
          </div>
        </div>
      </section>

      <!-- PLANOS (OPERAÇÕES CONECTADAS) -->
      <section class="section section-stack">
        <div class="section-heading section-heading--dark">
          <div class="section-label">{uiTexts.home.plans_label}</div>
          <p class="section-copy">{uiTexts.home.plans_description}</p>
        </div>
        <div class="link-grid">
          {planos.map((plano) => (
            <ProductCard
              id={plano.id}
              slug={plano.slug}
              title={plano.title}
              short_title={plano.short_title}
              description={plano.description}
              link={plano.link}
              price={plano.price}
              price_label={plano.price_label}
              category={plano.category}
              display_category={plano.display_category}
              featured={plano.featured}
              features={plano.features.slice(0, 4)}
            />
          ))}
        </div>
      </section>

      <!-- SERVIÇOS (IMPLEMENTAÇÕES À LA CARTE - SEÇÃO CLARA FULL-BLEED) -->
      <section class="section section-band">
        <div class="section-inner">
          <div class="section-heading">
            <div class="section-label section-label--light">{uiTexts.home.services_label}</div>
            <p class="section-copy">{uiTexts.home.services_description}</p>
          </div>
          <div class="link-grid">
            {servicos.map((servico) => (
              <ProductCard
                id={servico.id}
                slug={servico.slug}
                title={servico.title}
                short_title={servico.short_title}
                description={servico.description}
                link={servico.link}
                price={servico.price}
                price_label={servico.price_label}
                category={servico.category}
                display_category={servico.display_category}
                featured={servico.featured}
                features={servico.features.slice(0, 3)}
                isLightSection={true}
              />
            ))}
          </div>
        </div>
      </section>
    </div>

    <!-- SEÇÃO MÉTODO (SEÇÃO ESCURA NO BG #272727) -->
    <section id="metodo" class="method-section">
      <div class="section-label">{uiTexts.home.method.eyebrow}</div>
      <h2>
        {uiTexts.home.method.title}
      </h2>

      <div class="method-grid">
        {uiTexts.home.method.steps.map((step, index) => {
          const stepIcons = ['search', 'layers', 'zap', 'activity'];
          return (
            <div class="method-card">
              <div class="method-card-head">
                <span>
                  0{index + 1}
                </span>
                <i data-lucide={stepIcons[index] || 'zap'}></i>
              </div>
              <h3>{step.title}</h3>
              <p>{step.description}</p>
            </div>
          );
        })}
      </div>
    </section>

    <!-- SEÇÃO SOBRE & CLOSING (SEÇÃO CLARA FULL-BLEED FULL RHYTHM) -->
    <section class="section section-band about-band">
      <div class="about-inner">

        <!-- CARD SOBRE A AGÊNCIA & FOUNDER -->
        <div id="sobre" class="about-card">
          <div class="section-label section-label--light">{uiTexts.home.about.eyebrow}</div>
          <h2>
            {uiTexts.home.about.title}
          </h2>

          <!-- AVATAR CIRCULAR DO FOUNDER -->
          <div class="founder-block">
            <div class="founder-avatar">
              <img
                src={nodeneoImage.src}
                width={nodeneoImage.width}
                height={nodeneoImage.height}
                alt="Neo Mello — Founder & Lead Architect"
              />
              <div class="founder-status-shell">
                <div class="founder-status-dot"></div>
              </div>
            </div>

            <!-- FALA DO FOUNDER -->
            <div class="founder-note">
              <div class="founder-name">
                Neø Mello
              </div>
              <blockquote class="founder-quote">
                "Tecnologia só vale quando simplifica a operação de quem vende, atende e decide."
              </blockquote>
              <div class="founder-stack">
                Arquiteto de sistemas para operações comerciais com IA.
              </div>
              <p class="founder-contact-copy">
                Salve meu contato e me chame quando quiser conversar sobre sua operação.
              </p>
              <a
                href="/Neo_Mello.vcf"
                download="Neo_Mello.vcf"
                class="founder-contact"
                aria-label="Salvar o contato de Neø Mello na agenda"
              >
                <i data-lucide="contact"></i>
                Salvar Contato
              </a>
            </div>
          </div>

          <!-- TEXTOS SOBRE A AGÊNCIA -->
          <div class="about-copy">
            {uiTexts.home.about.paragraphs.map(p => (
              <p>{p}</p>
            ))}
          </div>
        </div>

        <!-- CLOSING / CTA FINAL -->
        <div class="closing-block">
          <div class="closing-kicker">
            <span>{uiTexts.home.closing.eyebrow}</span>
          </div>

          <h2>
            {uiTexts.home.closing.title}
          </h2>

          <p>
            {uiTexts.home.closing.body}
          </p>

          <div class="closing-actions">
            <a href="https://wa.me/556294789032" target="_blank" rel="noopener noreferrer" class="neo-button neo-button--dark">
              <i data-lucide="message-square"></i>
              {uiTexts.home.closing.primary_cta}
            </a>
          </div>
        </div>

      </div>
    </section>

    <!-- FOOTER -->
    <footer class="brand-footer">
      <img src={steelLogoImage.src} alt={uiTexts.footer.brand_name} width={steelLogoImage.width} height={steelLogoImage.height} loading="lazy" decoding="async" />
      <p>
        {uiTexts.footer.tagline}
      </p>
      <div class="brand-footer-statement">
        {uiTexts.footer.statement}
      </div>

      <!-- LINKS DE GOVERNANÇA E COMPLIANCE META -->
      <div class="brand-footer-links">
        <a href="/privacy" class="footer-governance-link">Política de Privacidade</a>
        <span aria-hidden="true">•</span>
        <a href="/legal" class="footer-governance-link">Termos de Serviço</a>
        <span aria-hidden="true">•</span>
        <a href="https://neoflowoff.agency/excluir-dados" class="footer-governance-link">Exclusão de Dados</a>
      </div>
      <p class="footer-legal-entity">
        {uiTexts.footer.legal_entity}
      </p>
    </footer>
  </div>

  <script>
    /* "EM BREVE" toast on soon element tap */
    document.querySelectorAll<HTMLElement>('.section-soon').forEach((el) => {
      el.addEventListener('click', (e: MouseEvent) => {
        const existing = document.querySelector('.soon-toast');
        if (existing) existing.remove();
        const toast = document.createElement('div');
        toast.className = 'soon-toast';
        toast.style.left = `${e.clientX}px`;
        toast.style.top = `${e.clientY}px`;
        toast.textContent = 'EM BREVE';
        document.body.appendChild(toast);
        setTimeout(() => toast.remove(), 1300);
      });
    });
  </script>
</Base>
