---
import { Image } from 'astro:assets';
import catalogData from '../../data/catalog.json';
import uiTexts from '../../data/ui_texts.json';
import Base from '../../layouts/Base.astro';
import steelLogoImage from '../../assets/images/steel_flw.webp';

export function getStaticPaths() {
  const planos = catalogData.products.filter(p => p.category === 'Plano');
  return planos.map(plano => ({
    params: { slug: plano.slug },
    props: { plano },
  }));
}

const { plano } = Astro.props;
---
<Base title={`${plano.title} | neoflowoff.agency`} description={plano.description}>
  <div class="detail-page">
    <header class="detail-header">
      <a href="/" class="back-link">
        <i data-lucide="chevron-left"></i>
        <span>{uiTexts.product_page.back_button}</span>
      </a>
    </header>

    <article class="detail-hero">
      <div class="detail-hero-copy">
        {plano.featured && (
          <div class="detail-status-chip">
            OPERAÇÃO PRINCIPAL
          </div>
        )}
        <div class="detail-kicker">{plano.display_category || uiTexts.product_page.plan_label}</div>
        <h1>{plano.title}</h1>
        <p>{plano.description}</p>
      </div>
      <aside class="detail-price-panel" aria-label="Resumo de preço">
        {plano.price_label && <span>{plano.price_label}</span>}
        <strong>R$ {plano.price.value.toLocaleString('pt-BR', { minimumFractionDigits: 2 })}</strong>
        <small>Pacote completo com diagnóstico e implantação.</small>
      </aside>
    </article>

    <section class="detail-section">
      <div class="section-label">{uiTexts.product_page.included_features_label}</div>
      <ul class="detail-list">
        {plano.features.map(feature => (
          <li>
            <i data-lucide="check-circle"></i>
            <span>{feature}</span>
          </li>
        ))}
      </ul>
    </section>

    {plano.outcomes && (
      <section class="detail-section detail-section--panel">
        <div class="section-label">{uiTexts.product_page.outcomes_label}</div>
        <ul class="detail-list detail-list--outcomes">
          {plano.outcomes.map(outcome => (
            <li>
              <i data-lucide="sparkles"></i>
              <span>{outcome}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="detail-cta" aria-label="Próximo passo">
      <p>
        {uiTexts.product_page.pricing_notice}
      </p>

      <div class="detail-actions">
        <button class="detail-action detail-action--primary">
          <i data-lucide="credit-card"></i>
          <span>{uiTexts.product_page.checkout_button}</span>
        </button>

        <a href={`https://wa.me/556294789032?text=Olá!%20Gostaria%20de%20validar%20o%20escopo%20do%20plano%20${encodeURIComponent(plano.title)}`} target="_blank" rel="noopener noreferrer" class="detail-action detail-action--secondary">
          <i data-lucide="message-circle"></i>
          <span>{uiTexts.product_page.contact_button}</span>
        </a>
      </div>
    </section>

    <footer class="detail-footer">
      <Image class="detail-footer-logo" src={steelLogoImage} alt={uiTexts.footer.brand_name} loading="lazy" decoding="async" />
      <p>
        {uiTexts.footer.tagline}
      </p>
      <img class="detail-footer-badge" src="/assets/badge_meta_tech_provider.webp" alt="Meta Tech Provider" loading="lazy" decoding="async" width="1400" height="401" />
      <p class="footer-legal-entity">
        {uiTexts.footer.legal_entity}
      </p>
    </footer>
  </div>
</Base>
