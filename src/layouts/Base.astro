        'https://wa.me/556294789032'
      ],
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'customer support',
        telephone: '+55-62-94789032',
        email: 'neo@neoflowoff.agency',
        availableLanguage: ['pt-BR', 'en']
      }
    },
    {
      '@type': 'WebSite',
      '@id': `${platformBaseUrl}/#website`,
      url: platformBaseUrl,
      name: brandSearchName,
      alternateName: brandAlternateNames,
      inLanguage: 'pt-BR',
      publisher: {
        '@id': `${platformBaseUrl}/#organization`
      }
    },
    {
      '@type': 'WebPage',
      '@id': canonicalUrl,
      url: canonicalUrl,
      name: title,
      description,
      inLanguage: 'pt-BR',
      isPartOf: {
        '@id': `${platformBaseUrl}/#website`
