---
import '../styles/global.css';
import fs from 'node:fs';
import path from 'node:path';
import uiTexts from '../data/ui_texts.json';

// Read config to get meta verification token
const configPath = path.join(process.cwd(), 'src/data/config.json');
const configData = JSON.parse(fs.readFileSync(configPath, 'utf8'));
const metaVerifyToken = configData.integrations.meta.domain_verification;
const metaPixelId = String(configData.integrations.meta?.pixel_id || '');
const tiktokPixelId = String(configData.integrations.tiktok?.pixel_id || '');
const platformBaseUrl = String(configData.platform.base_url || 'https://neoflowoff.agency').replace(/\/$/, '');
const canonicalUrl = new URL(Astro.url.pathname, platformBaseUrl).toString();
const ogImageUrl = new URL('/assets/og-image.png', platformBaseUrl).toString();
const brandOfficialName = 'NEØ FlowOFF';
const brandSearchName = 'Neo FlowOFF Agency';
const brandAlternateNames = [brandOfficialName, 'NeoFlowOFF', 'NEO FlowOFF', 'neoflowoff.agency'];
const brandCategoryDescription = 'Infraestrutura Comercial, Automação de Processos, Integração de CRM e Agentes de IA Customizados em Goiânia, GO.';
const title = Astro.props.title || uiTexts.meta.default_title;
const description = Astro.props.description || uiTexts.meta.default_description;
const keywords = uiTexts.meta.keywords.join(', ');
const tiktokPixelScript = tiktokPixelId ? `
