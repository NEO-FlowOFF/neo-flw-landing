---
import Base from '../layouts/Base.astro';

const title = 'TikTok Shop Brasil para Creators e Lojistas | NEØ FlowOFF';
const description =
  'Uma entrada direta para creators e lojistas começarem no TikTok Shop Brasil, acessarem os canais oficiais e avançarem com suporte operacional.';
const creatorUrl = 'https://business.tiktokshop.com/pt/creator';
const sellerUrl = 'https://seller-br.tiktok.com/account/register';
const creatorSupportUrl =
  'https://wa.me/556282705594?text=Ol%C3%A1%2C%20sou%20creator%20e%20quero%20entrar%20no%20TikTok%20Shop.%20[utm:tiktok-shop-creator]';
const sellerSupportUrl =
  'https://wa.me/556282705594?text=Ol%C3%A1%2C%20sou%20lojista%20e%20quero%20acelerar%20minha%20entrada%20no%20TikTok%20Shop.%20[utm:tiktok-shop-lojista]';

const currentYear = new Date().getFullYear();

const tiktokShopSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  'name': title,
  'description': description,
  'url': 'https://neoflowoff.agency/tiktok-shop/',
  'publisher': {
    '@type': 'Organization',
    'name': 'NEØ FlowOFF',
    'url': 'https://neoflowoff.agency'
  }
};

const benefits = [
  [
    'Creators',
    'Produtos para divulgar',
    'Acesse o marketplace de produtos, campanhas, convites de colaboração e oportunidades de comissão.',
  ],
  [
    'Lojistas',
    'Venda onde a descoberta acontece',
    'Abra sua loja, conecte conteúdo ao catálogo e prepare a operação para vídeos compráveis e LIVE.',
  ],
  [
    'Operação',
    'Menos caminho perdido',
    'Entre pelo fluxo correto, entenda o que falta e avance para a camada de acompanhamento da NEØ FlowOFF.',
  ],
];
---

<Base title={title} description={description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(tiktokShopSchema)} />
  </Fragment>
  <main class="shop-entry-page">
    <header class="shop-nav">
      <a class="shop-brand" href="/" aria-label="Voltar para neoflowoff.agency">
        <img
          src="/logo_transp.svg"
          alt="NEØ FlowOFF"
          width="656"
          height="72"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </a>
      <a class="shop-nav-link" href="#entradas">Escolher meu acesso</a>
    </header>

    <section class="shop-hero" aria-labelledby="shop-title">
      <div class="shop-orbit" aria-hidden="true"></div>
      <div class="shop-eyebrow">
        <span></span> TikTok Shop Brasil · entrada operacional
      </div>
      <h1 id="shop-title">Uma entrada.<br /><em>Dois caminhos.</em></h1>
      <p class="shop-lead">
        Creator encontra produtos e oportunidades para monetizar conteúdo.
        Lojista abre o canal e começa a vender dentro do TikTok. A NEØ FlowOFF
        organiza o caminho entre os dois.
      </p>
      <div class="shop-hero-actions">
        <a class="shop-button shop-button--primary" href="#entradas"
          >Começar agora</a
        >
        <a class="shop-button shop-button--ghost" href="#como-funciona"
          >Entender o fluxo</a
        >
      </div>
      <div class="shop-status" aria-label="Status da plataforma">
        <span><b>01</b> Entrada pública</span>
        <span><b>02</b> Direcionamento oficial</span>
        <span><b>03</b> Dashboard em evolução</span>
      </div>
    </section>

    <section class="shop-section" id="entradas" aria-labelledby="entry-title">
      <div class="shop-section-heading">
        <span>Escolha seu lado da operação</span>
        <h2 id="entry-title">
          Você cria demanda ou coloca produto na prateleira?
        </h2>
      </div>

      <div class="entry-grid">
        <article class="entry-card entry-card--creator">
          <div class="entry-number">01 / CREATOR</div>
          <h3>Transforme conteúdo em comissão.</h3>
          <p>
            Verifique sua elegibilidade, encontre produtos para divulgar e
            acesse oportunidades oficiais do TikTok Shop.
          </p>
          <ul>
            <li>Marketplace de produtos</li>
            <li>Campanhas e convites de marcas</li>
            <li>Comissões em vídeos e LIVE</li>
          </ul>
          <div class="entry-actions">
            <a
              class="shop-button shop-button--primary"
              href={creatorUrl}
              target="_blank"
              rel="noopener noreferrer">Acessar como Creator</a
            >
            <a
              class="text-link"
              href={creatorSupportUrl}
              target="_blank"
              rel="noopener noreferrer">Quero suporte para entrar →</a
            >
          </div>
        </article>

        <article class="entry-card entry-card--seller">
          <div class="entry-number">02 / LOJISTA</div>
          <h3>Transforme atenção em venda.</h3>
          <p>
            Cadastre sua empresa, abra a loja e prepare catálogo, conteúdo e
            operação para vender dentro do TikTok.
          </p>
          <ul>
            <li>Cadastro no Seller Center Brasil</li>
            <li>Vídeos compráveis, vitrine e LIVE</li>
            <li>Acesso ao ecossistema de creators</li>
          </ul>
          <div class="entry-actions">
            <a
              class="shop-button shop-button--light"
              href={sellerUrl}
              target="_blank"
              rel="noopener noreferrer">Abrir minha loja</a
            >
            <a
              class="text-link"
              href={sellerSupportUrl}
              target="_blank"
              rel="noopener noreferrer">Quero acelerar meu setup →</a
            >
          </div>
        </article>
      </div>
    </section>

    <section
      class="shop-section shop-section--flow"
      id="como-funciona"
      aria-labelledby="flow-title"
    >
      <div class="shop-section-heading">
        <span>O que esta camada resolve</span>
        <h2 id="flow-title">A porta certa antes do painel.</h2>
      </div>
      <div class="benefit-grid">
        {
          benefits.map(([label, heading, body], index) => (
            <article class="benefit-card">
              <div class="benefit-meta">
                <>
                  <b>0{index + 1}</b>
                  <span>{label}</span>
                </>
              </div>
              <h3>{heading}</h3>
              <p>{body}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="dashboard-preview" aria-labelledby="dashboard-title">
      <div>
        <span class="dashboard-label">Próxima camada</span>
        <h2 id="dashboard-title">Dashboard NEØ TikTok Shop Connector.</h2>
        <p>
          O próximo passo centraliza onboarding, status de conexão, creators,
          lojas e oportunidades. A landing já libera a entrada; o painel
          organiza a operação.
        </p>
      </div>
      <div class="dashboard-shell" aria-hidden="true">
        <div class="dashboard-top">
          <i></i><i></i><i></i><span>connector / overview</span>
        </div>
        <div class="dashboard-grid">
          <div>
            <small>CREATORS</small><strong>onboarding</strong><span
              >entrada e elegibilidade</span
            >
          </div>
          <div>
            <small>LOJAS</small><strong>seller access</strong><span
              >cadastro e conexão</span
            >
          </div>
          <div>
            <small>OPERAÇÃO</small><strong>next layer</strong><span
              >dashboard em evolução</span
            >
          </div>
        </div>
      </div>
    </section>

    <section class="shop-final">
      <span>Comece pelo caminho que gera receita para você.</span>
      <h2>Creator ou lojista: entre agora.</h2>
      <div class="shop-hero-actions">
        <a
          class="shop-button shop-button--primary"
          href={creatorUrl}
          target="_blank"
          rel="noopener noreferrer">Sou Creator</a
        >
        <a
          class="shop-button shop-button--ghost"
          href={sellerUrl}
          target="_blank"
          rel="noopener noreferrer">Sou Lojista</a
        >
      </div>
    </section>

    <footer class="shop-footer">
      <span>© {currentYear} neoflowoff agency · TikTok Shop Connector</span>
      <nav aria-label="Links legais">
        <a href="/privacy/">Privacidade</a>
        <a href="/terms/">Termos</a>
        <a href="mailto:neo@neoflowoff.agency">Contato</a>
      </nav>
      <p>
        neoflowoff agency é uma operação independente. TikTok e TikTok Shop são
        marcas de seus respectivos titulares.
      </p>
    </footer>
  </main>
</Base>

<style>
  .shop-entry-page {
    --shop-bg: #08090a;
    --shop-line: rgba(255, 255, 255, 0.12);
    --shop-muted: #a4a8ad;
    min-height: 100vh;
    color: #f7f7f4;
    background:
      radial-gradient(
        circle at 85% 8%,
        rgba(224, 255, 0, 0.1),
        transparent 24rem
      ),
      linear-gradient(180deg, #111315 0%, var(--shop-bg) 50%, #050505 100%);
    font-family: var(--font-body, 'Figtree', system-ui, sans-serif);
  }

  .shop-nav,
  .shop-hero,
  .shop-section,
  .dashboard-preview,
  .shop-final,
  .shop-footer {
    width: min(1180px, calc(100% - 2rem));
    margin-inline: auto;
  }

  .shop-nav {
    min-height: 5.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid var(--shop-line);
  }
  .shop-brand img {
    width: min(15rem, 50vw);
    height: auto;
    display: block;
  }
  .shop-nav-link {
    color: var(--acid);
    font-weight: 800;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .shop-hero {
    position: relative;
    padding: clamp(5rem, 11vw, 9rem) 0 4rem;
    overflow: hidden;
  }
  .shop-orbit {
    position: absolute;
    right: -12rem;
    top: 3rem;
    width: 36rem;
    aspect-ratio: 1;
    border: 1px solid rgba(224, 255, 0, 0.18);
    border-radius: 50%;
    box-shadow:
      0 0 0 5rem rgba(224, 255, 0, 0.015),
      0 0 0 10rem rgba(224, 255, 0, 0.01);
  }
  .shop-orbit::after {
    content: '';
    position: absolute;
    inset: 50%;
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    background: var(--acid);
    box-shadow: 0 0 32px var(--acid);
  }
  .shop-eyebrow {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--acid);
    font-family: var(--mono);
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .shop-eyebrow span {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--acid);
    box-shadow: 0 0 16px var(--acid);
  }
  .shop-hero h1 {
    position: relative;
    max-width: 900px;
    margin: 1.5rem 0;
    font-size: clamp(4rem, 10vw, 8.6rem);
    line-height: 0.82;
    letter-spacing: -0.075em;
    text-transform: uppercase;
  }
  .shop-hero h1 em {
    color: var(--acid);
    font-style: normal;
  }
  .shop-lead {
    position: relative;
    max-width: 760px;
    color: var(--shop-muted);
    font-size: clamp(1rem, 2vw, 1.25rem);
    line-height: 1.7;
  }
  .shop-hero-actions {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2rem;
  }
  .shop-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3.35rem;
    padding: 0.85rem 1.25rem;
    border: 1px solid transparent;
    border-radius: 0.7rem;
    font-weight: 900;
    letter-spacing: -0.01em;
    transition:
      transform 0.18s ease,
      border-color 0.18s ease;
  }
  .shop-button:hover {
    transform: translateY(-2px);
  }
  .shop-button--primary {
    color: #090a0a;
    background: var(--acid);
  }
  .shop-button--ghost {
    color: #fff;
    background: rgba(255, 255, 255, 0.035);
    border-color: var(--shop-line);
  }
  .shop-button--light {
    color: #050505;
    background: #f3f3ee;
  }
  .shop-status {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    margin-top: 4.5rem;
    background: var(--shop-line);
    border: 1px solid var(--shop-line);
    border-radius: 1rem;
    overflow: hidden;
  }
  .shop-status span {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 1.15rem;
    background: #0d0f10;
    color: var(--shop-muted);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .shop-status b {
    color: var(--acid);
    font-family: var(--mono);
  }
  .shop-section {
    padding: 6rem 0;
  }
  .shop-section-heading {
    max-width: 900px;
    margin-bottom: 2rem;
  }
  .shop-section-heading > span,
  .dashboard-label,
  .shop-final > span {
    color: var(--acid);
    font-family: var(--mono);
    font-size: 0.75rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .shop-section-heading h2,
  .dashboard-preview h2,
  .shop-final h2 {
    margin: 0.8rem 0 0;
    font-size: clamp(2.5rem, 6vw, 5.5rem);
    line-height: 0.95;
    letter-spacing: -0.055em;
    text-transform: uppercase;
  }
  .entry-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  .entry-card {
    min-height: 35rem;
    padding: clamp(1.5rem, 4vw, 3rem);
    display: flex;
    flex-direction: column;
    border-radius: 1.5rem;
    overflow: hidden;
  }
  .entry-card--creator {
    color: #f7f7f4;
    background: linear-gradient(145deg, #171a1c, #0d0f10);
    border: 1px solid var(--shop-line);
  }
  .entry-card--seller {
    color: #111;
    background: var(--acid);
  }
  .entry-number {
    font-family: var(--mono);
    font-size: 0.75rem;
    font-weight: 900;
    letter-spacing: 0.12em;
  }
  .entry-card--creator .entry-number {
    color: var(--acid);
  }
  .entry-card h3 {
    max-width: 520px;
    margin: 4rem 0 1rem;
    font-size: clamp(2.2rem, 4vw, 4rem);
    line-height: 0.95;
    letter-spacing: -0.05em;
    text-transform: uppercase;
  }
  .entry-card p {
    max-width: 560px;
    line-height: 1.7;
  }
  .entry-card--creator p,
  .entry-card--creator li {
    color: var(--shop-muted);
  }
  .entry-card ul {
    margin: 1.5rem 0 2rem;
    padding-left: 1.2rem;
    line-height: 1.9;
  }
  .entry-actions {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }
  .text-link {
    font-weight: 850;
    font-size: 0.9rem;
  }
  .entry-card--creator .text-link {
    color: var(--acid);
  }
  .shop-section--flow {
    border-top: 1px solid var(--shop-line);
  }
  .benefit-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  .benefit-card {
    padding: 1.5rem;
    border: 1px solid var(--shop-line);
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.025);
  }
  .benefit-meta {
    display: flex;
    justify-content: space-between;
    color: var(--shop-muted);
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .benefit-meta b {
    color: var(--acid);
  }
  .benefit-card h3 {
    margin: 3.5rem 0 0.8rem;
    font-size: 1.35rem;
    text-transform: uppercase;
  }
  .benefit-card p {
    color: var(--shop-muted);
    line-height: 1.7;
  }
  .dashboard-preview {
    padding: clamp(2rem, 5vw, 4rem);
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 3rem;
    align-items: center;
    border: 1px solid var(--shop-line);
    border-radius: 1.5rem;
    background: #0e1011;
  }
  .dashboard-preview h2 {
    font-size: clamp(2rem, 4vw, 4rem);
  }
  .dashboard-preview p {
    color: var(--shop-muted);
    line-height: 1.7;
  }
  .dashboard-shell {
    border: 1px solid rgba(224, 255, 0, 0.2);
    border-radius: 1rem;
    overflow: hidden;
    background: #080909;
    box-shadow: 0 28px 80px rgba(0, 0, 0, 0.45);
  }
  .dashboard-top {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.85rem;
    border-bottom: 1px solid var(--shop-line);
    color: var(--shop-muted);
    font-family: var(--mono);
    font-size: 0.68rem;
  }
  .dashboard-top i {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: #333;
  }
  .dashboard-top i:first-child {
    background: var(--acid);
  }
  .dashboard-top span {
    margin-left: auto;
  }
  .dashboard-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--shop-line);
  }
  .dashboard-grid div {
    min-height: 9rem;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    background: #0c0e0f;
  }
  .dashboard-grid small {
    color: var(--acid);
    font-family: var(--mono);
  }
  .dashboard-grid strong {
    margin-top: auto;
    text-transform: uppercase;
  }
  .dashboard-grid span {
    color: var(--shop-muted);
    font-size: 0.7rem;
  }
  .shop-final {
    padding: 8rem 0;
  }
  .shop-footer {
    padding: 2rem 0;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 1rem;
    border-top: 1px solid var(--shop-line);
    color: var(--shop-muted);
    font-size: 0.78rem;
  }
  .shop-footer nav {
    display: flex;
    gap: 1rem;
  }
  .shop-footer p {
    grid-column: 1 / -1;
    margin: 0;
    font-size: 0.7rem;
  }

  @media (max-width: 820px) {
    .shop-orbit {
      opacity: 0.5;
    }
    .entry-grid,
    .benefit-grid,
    .dashboard-preview {
      grid-template-columns: 1fr;
    }
    .shop-status {
      grid-template-columns: 1fr;
    }
    .entry-card {
      min-height: 31rem;
    }
    .dashboard-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .shop-nav-link {
      display: none;
    }
    .shop-hero h1 {
      font-size: clamp(3.4rem, 20vw, 5.5rem);
    }
    .shop-button {
      width: 100%;
    }
    .shop-footer {
      grid-template-columns: 1fr;
    }
    .shop-footer nav {
      flex-wrap: wrap;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .shop-button {
      transition: none;
    }
  }
</style>
