---
import BadgeChip from './BadgeChip.astro';

const { id, slug, title, short_title, sub, description, link, price, price_label, category, display_category, featured, fullWidth, isSoon, features, isLightSection, forceGrid } = Astro.props;

const targetHref = slug 
  ? (category === 'Serviço' ? `/checkout/${slug}` : `/planos/${slug}`) 
  : link;
const href = isSoon ? '#' : targetHref;

const isFeaturedCard = featured && !forceGrid;
const isFullRow = !forceGrid && (featured || fullWidth || slug === 'aquisicao-multicanal' || slug === 'operacao-custom-enterprise');
const baseCardClass = isFeaturedCard ? 'lc lc-featured' : (isFullRow ? 'lc lc-fullwidth' : (isSoon ? 'lc section-soon' : 'lc'));

const getIcon = (itemSlug: string, itemCategory: string) => {
  if (itemSlug?.includes('whatsapp')) return 'message-square';
  if (itemSlug?.includes('tiktok')) return 'box';
  if (itemSlug?.includes('auditoria')) return 'shield-check';
  if (itemSlug?.includes('meta') && itemSlug?.includes('app')) return 'layers';
  if (itemSlug?.includes('dashboard')) return 'bar-chart-3';
  if (itemSlug?.includes('webapp') || itemSlug?.includes('landing')) return 'layout';
  if (itemSlug?.includes('a2m') || itemSlug?.includes('poi')) return 'shield-check';
  if (itemSlug?.includes('sdr')) return 'bot';
  if (itemSlug?.includes('agents') || itemSlug?.includes('agente-ia')) return 'cpu';
  if (itemSlug?.includes('crm')) return 'git-branch';
  if (itemSlug?.includes('fluxo') || itemSlug?.includes('automacao')) return 'zap';
  if (itemSlug?.includes('aquisicao') || itemSlug?.includes('trafego')) return 'share-2';
  if (itemSlug?.includes('google')) return 'search';
  if (itemSlug?.includes('custom') || itemSlug?.includes('enterprise')) return 'layers';
  if (itemSlug?.includes('regularizacao')) return 'shield-check';
  if (itemSlug?.includes('meta')) return 'share-2';
  return itemCategory === 'Serviço' ? 'terminal' : 'box';
};

const iconName = getIcon(slug, category);
const isMetaCard = slug?.includes('meta') || slug?.includes('whatsapp');
const cardClass = [
  baseCardClass,
  isLightSection ? 'lc--light' : '',
  isMetaCard ? 'lc--meta' : ''
].filter(Boolean).join(' ');
---
<a href={href} class={cardClass}>
  {isFeaturedCard ? (
    <div class="product-card-row">
      <div class="lc-icon product-card-icon">
        <i data-lucide={iconName}></i>
      </div>
      <div class="lc-body product-card-body">
        <div class="product-card-badge">
          <BadgeChip label="OPERAÇÃO PRINCIPAL" color="acid" pulse={true} />
        </div>
        <div class="lc-title product-card-featured-title">{short_title || title}</div>
        <div class="lc-sub">{display_category || category}</div>
        {description && <p class="lc-desc">{description}</p>}
      </div>
      <div class="product-card-action-slot">
        <span class="card-action card-action--strong">
          Ver detalhes <i data-lucide="chevron-right"></i>
        </span>
      </div>
    </div>
  ) : isFullRow ? (
    <div class="product-card-row">
      <div class="lc-icon product-card-icon">
        <i data-lucide={iconName}></i>
      </div>
      <div class="lc-body product-card-body">
        <div class="lc-title product-card-row-title">{short_title || title}</div>
        <div class="lc-sub">{display_category || category}</div>
        {description && <p class="lc-desc">{description}</p>}
      </div>
      <div class="product-card-action-slot">
        <span class="card-action">
          Ver detalhes <i data-lucide="chevron-right"></i>
        </span>
      </div>
    </div>
  ) : (
    <>
      <div class="product-card-top">
        <div class="lc-icon">
          <i data-lucide={iconName}></i>
        </div>
        {display_category && (
          <span class="product-card-category">
            {display_category.replace('Implementação ', '').replace('Operação ', '')}
          </span>
        )}
      </div>

      <div class="lc-body product-card-body product-card-body--stack">
        <div class="lc-title">{short_title || title}</div>
        <div class="lc-sub">{sub || category}</div>
        {description && <p class="lc-desc">{description}</p>}
      </div>
      
      <div class="product-card-footer">
        <span class="card-action">
          Ver detalhes <i data-lucide="chevron-right"></i>
        </span>
      </div>
    </>
  )}
</a>
