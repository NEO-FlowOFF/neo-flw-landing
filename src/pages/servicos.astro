---
import Base from '../layouts/Base.astro';
import HubHeader from '../components/HubHeader.astro';
import BrandFooter from '../components/BrandFooter.astro';
import BadgeChip from '../components/BadgeChip.astro';
import catalogData from '../data/catalog.json';

const title = 'Catálogo de Serviços & Soluções | NEØ FlowOFF';
const description = 'Catálogo oficial de serviços de infraestrutura comercial, WhatsApp Business API oficial, CRM, automações, landing pages e agentes de IA da neoflowoff.agency.';

const products = catalogData.products;

const categories = [
  { id: 'todos', label: 'Todos os Serviços' },
  { id: 'diagnostico', label: 'Diagnósticos & Setups' },
  { id: 'meta', label: 'WhatsApp & Meta' },
  { id: 'ia', label: 'Agentes de IA' },
  { id: 'automacao', label: 'CRM & Automações' },
  { id: 'midia', label: 'Mídia & Performance' },
];

const getCategoryFilter = (slug: string) => {
  const s = slug.toLowerCase();
  if (s.includes('diagnostico') || s.includes('auditoria') || s.includes('setup-inicial') || s.includes('webapp')) return 'diagnostico';
  if (s.includes('whatsapp') || s.includes('meta')) return 'meta';
  if (s.includes('agent') || s.includes('sdr') || s.includes('ia') || s.includes('custom')) return 'ia';
  if (s.includes('crm') || s.includes('fluxo') || s.includes('automacao') || s.includes('dashboard')) return 'automacao';
  if (s.includes('aquisicao') || s.includes('trafego') || s.includes('google')) return 'midia';
  return 'diagnostico';
};

const getProductImagePath = (imageLink?: string) => {
  if (!imageLink) return '/assets/og-image.png';
  if (imageLink.startsWith('http')) {
    try {
      const url = new URL(imageLink);
      return url.pathname;
    } catch {
      return imageLink;
    }
  }
  return imageLink;
};

const getMetalIcon = (slug: string) => {
  const s = slug.toLowerCase();
  if (s.includes('tiktok')) return { src: '/assets/tiktok_metal.png', alt: 'TikTok Partner' };
  if (s.includes('whatsapp') || s.includes('meta')) return { src: '/assets/meta_metal.png', alt: 'Meta Tech Provider' };
  return { src: '/assets/NEO_metal.png', alt: 'NEØ Protocol' };
};

const tickerItems = [
  'Catálogo Oficial: Soluções modulares de infraestrutura comercial e agentes de IA prontos para implementação.',
  'Meta Tech Provider: WhatsApp Cloud API homologado, Graph API v25.0 e webhooks em tempo real.',
  'TikTok Shop Brasil: Catálogo sincronizado, verificação de seller e integrações de checkout.',
  'Engenharia Comercial: CRM inteligente, automações sem fricção e páginas com taxa máxima de conversão.',
];
const tickerLoopItems = [...tickerItems, ...tickerItems];

const servicosSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  'name': title,
  'description': description,
  'url': 'https://neoflowoff.agency/servicos/',
  'mainEntity': {
    '@type': 'ItemList',
    'itemListElement': products.map((p, idx) => ({
      '@type': 'ListItem',
      'position': idx + 1,
      'item': {
        '@type': p.category === 'Serviço' ? 'Service' : 'Product',
        'name': p.title,
        'image': p.image_link,
        'url': p.category === 'Serviço' ? `https://neoflowoff.agency/checkout/${p.slug}/` : `https://neoflowoff.agency/planos/${p.slug}/`,
        'description': p.description,
        ...(p.price.value > 0 ? {
          'offers': {
            '@type': 'Offer',
            'price': p.price.value.toString(),
            'priceCurrency': 'BRL',
            'availability': 'https://schema.org/InStock'
          }
        } : {})
      }
    }))
  }
};
---

<Base title={title} description={description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(servicosSchema)} />
  </Fragment>

  <div class="services-hub-page">
    <!-- TOP TELENOTÍCIAS TICKER BAR (Mídia & Infraestrutura) -->
    <div class="top-telenoticias-bar">
      <div class="digital-ticker-portal">
        <div class="ticker-track">
          {
            tickerLoopItems.map((item) => (
              <span class="ticker-item">
                <span class="ticker-live-badge">AO VIVO</span>
                <span>{item}</span>
                <span class="ticker-dot">◆</span>
              </span>
            ))
          }
        </div>
      </div>
    </div>

    <!-- HUB HEADER (STICKY BLURRED) -->
    <div class="header-container">
      <HubHeader homeHref="/" anchorBase="/" />
    </div>

    <!-- HERO DO CATÁLOGO -->
    <header class="services-hero">
      <div class="services-hero-inner">
        <!-- BARRA METÁLICA DE PLATAFORMAS INTEGRADAS (MOBILE HORIZONTAL SCROLL) -->
        <div class="metal-pillars-wrapper">
          <div class="metal-pillars-bar" aria-label="Plataformas e Ecossistemas Oficiais">
            <div class="metal-pillar-item">
              <img src="/assets/NEO_metal.png" alt="NEØ Core" width="22" height="22" loading="eager" decoding="async" />
              <span>NEØ Core &amp; IA</span>
            </div>
            <span class="pillar-dot" aria-hidden="true">◆</span>
            <div class="metal-pillar-item">
              <img src="/assets/EngineOne.png" alt="NEØFLW ENGINE:one" width="20" height="20" loading="eager" decoding="async" class="engine-mini-logo" />
              <span>NEØFLW ENGINE:one</span>
            </div>
            <span class="pillar-dot" aria-hidden="true">◆</span>
            <div class="metal-pillar-item">
              <img src="/assets/meta_metal.png" alt="Meta Tech Provider" width="22" height="22" loading="eager" decoding="async" />
              <span>Meta Tech Provider</span>
            </div>
            <span class="pillar-dot" aria-hidden="true">◆</span>
            <div class="metal-pillar-item">
              <img src="/assets/tiktok_metal.png" alt="TikTok Partner" width="22" height="22" loading="eager" decoding="async" />
              <span>TikTok Partner</span>
            </div>
          </div>
        </div>

        <div class="hero-kicker">
          <span class="kicker-dot" aria-hidden="true"></span>
          <span>Catálogo de Soluções · neoflowoff.agency</span>
        </div>

        <h1>Serviços &amp; Infraestrutura</h1>
        <p class="hero-lead">
          Setups oficiais de mensageria, automações comerciais, CRM, landing pages ultra-rápidas e agentes de IA integrados.
        </p>

        <!-- FILTROS DE CATEGORIA (MOBILE-FIRST SCROLL COM CHIPS) -->
        <div class="filter-wrapper">
          <div class="filter-bar" role="tablist" aria-label="Filtrar serviços por categoria">
            {categories.map((cat, idx) => {
              const count = cat.id === 'todos'
                ? products.length
                : products.filter(p => getCategoryFilter(p.slug) === cat.id).length;

              return (
                <button
                  class={`filter-pill ${idx === 0 ? 'is-active' : ''}`}
                  data-filter={cat.id}
                  role="tab"
                  aria-selected={idx === 0 ? 'true' : 'false'}
                >
                  <span class="filter-pill-label">{cat.label}</span>
                  <span class="filter-pill-count">{count}</span>
                </button>
              );
            })}
          </div>
        </div>
      </div>
    </header>

    <!-- GRID DE PRODUTOS/SERVIÇOS COM IMAGENS DEDICADAS -->
    <main class="services-container">
      <div class="services-grid" id="services-grid">
        {products.map((p) => {
          const filterGroup = getCategoryFilter(p.slug);
          const targetUrl = p.category === 'Serviço' ? `/checkout/${p.slug}/` : `/planos/${p.slug}/`;
          const isFeatured = p.featured;
          const metalIcon = getMetalIcon(p.slug);
          const imagePath = getProductImagePath(p.image_link);

          return (
            <article
              class={`service-card ${isFeatured ? 'service-card--featured' : ''}`}
              data-category={filterGroup}
            >
              <!-- IMAGEM DO PRODUTO (3D RENDER / PREVIEW) -->
              <div class="service-card-media">
                <a href={targetUrl} class="service-media-link" tabindex="-1" aria-hidden="true">
                  <img
                    src={imagePath}
                    alt={`${p.title} - ${p.headline || p.display_category}`}
                    class="service-media-img"
                    width="600"
                    height="338"
                    loading="lazy"
                    decoding="async"
                  />
                  <div class="service-media-overlay"></div>
                </a>

                <!-- BADGES SOBREPOSTAS À IMAGEM -->
                <div class="service-media-badges">
                  <span class="service-category-badge">
                    {p.display_category || p.category}
                  </span>
                  
                  <div class="service-partner-badge" title={metalIcon.alt}>
                    <img
                      src={metalIcon.src}
                      alt={metalIcon.alt}
                      width="20"
                      height="20"
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                </div>

                {isFeatured && (
                  <div class="service-featured-pill">
                    <BadgeChip label="OPERAÇÃO PRINCIPAL" color="acid" pulse={true} />
                  </div>
                )}
              </div>

              <!-- CORPO DO CARD -->
              <div class="service-card-body">
                {p.headline && <span class="service-headline">{p.headline}</span>}
                
                <h2 class="service-title">
                  <a href={targetUrl} class="service-title-link">
                    {p.title}
                  </a>
                </h2>

                <p class="service-desc">{p.description}</p>

                <!-- CHECKLIST DE ENTREGÁVEIS PRINCIPAIS -->
                {p.features && p.features.length > 0 && (
                  <ul class="service-features-list">
                    {p.features.slice(0, 3).map((f) => (
                      <li>
                        <i data-lucide="check" aria-hidden="true"></i>
                        <span>{f}</span>
                      </li>
                    ))}
                  </ul>
                )}
              </div>

              <!-- FOOTER COM PREÇO E BOTÃO TOUCH-TARGET -->
              <div class="service-card-footer">
                <div class="service-price-block">
                  <span class="service-price-label">{p.price_label || 'A partir de'}</span>
                  <span class="service-price-val">{p.price_display || (p.price.value > 0 ? `R$ ${p.price.value.toLocaleString('pt-BR', { minimumFractionDigits: 2 })}` : 'Sob consulta')}</span>
                </div>

                <a href={targetUrl} class="service-action-btn">
                  <span>Ver Especificação</span>
                  <i data-lucide="arrow-up-right" aria-hidden="true"></i>
                </a>
              </div>
            </article>
          );
        })}
      </div>

      <!-- BANNER DE PROJETOS CUSTOM / ENTERPRISE (MOBILE-FIRST) -->
      <section class="custom-cta-band">
        <div class="custom-cta-copy">
          <span class="custom-kicker">DEMANDAS ESPECÍFICAS &amp; ENTERPRISE</span>
          <h3>Precisa de uma arquitetura sob medida?</h3>
          <p>
            Desenvolvemos integrações corporativas complexas, data lakehouses, ecossistemas multi-agente
            e pipelines dedicadas de mensageria para operações com alta volumetria.
          </p>
        </div>
        <div class="custom-cta-actions">
          <a
            href="https://wa.me/556282705594?text=Ol%C3%A1%2C%20gostaria%20de%20conversar%20sobre%20um%20projeto%20sob%20medida%20para%20minha%20empresa.%20[utm:servicos-custom]"
            target="_blank"
            rel="noopener noreferrer"
            class="custom-whatsapp-btn"
          >
            <i data-lucide="message-circle" aria-hidden="true"></i>
            <span>Validar Escopo no WhatsApp</span>
          </a>
        </div>
      </section>
    </main>

    <BrandFooter />
  </div>

  <script>
    // Filtro interativo no client-side com transição suave
    const filterButtons = document.querySelectorAll<HTMLButtonElement>('.filter-pill');
    const cards = document.querySelectorAll<HTMLElement>('.service-card');

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.dataset.filter || 'todos';

        filterButtons.forEach((b) => {
          b.classList.remove('is-active');
          b.setAttribute('aria-selected', 'false');
        });
        btn.classList.add('is-active');
        btn.setAttribute('aria-selected', 'true');

        cards.forEach((card) => {
          const cardCat = card.dataset.category;
          if (filter === 'todos' || cardCat === filter) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  </script>
</Base>

<style>
  /* ════════════════════════════════════════════════════════════
     PÁGINA /SERVICOS · 99% MOBILE-FIRST CSS ARCHITECTURE
     ════════════════════════════════════════════════════════════ */

  .services-hub-page {
    min-height: 100vh;
    background: #09090b;
    color: #f4f4f5;
    position: relative;
    overflow-x: hidden;
  }

  /* ── TOP TICKER BAR (AO VIVO) ── */
  .top-telenoticias-bar {
    width: 100%;
    background: #0b0b0e;
    color: #ffffff;
    padding: 6px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    overflow: hidden;
    position: relative;
    z-index: 101;
  }

  .digital-ticker-portal {
    position: relative;
    width: 100%;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent 0px, #000 16px, #000 calc(100% - 16px), transparent 100%);
    mask-image: linear-gradient(90deg, transparent 0px, #000 16px, #000 calc(100% - 16px), transparent 100%);
  }

  .ticker-track {
    display: flex;
    width: max-content;
    animation: ticker-loop 36s linear infinite;
    gap: 2rem;
  }

  .ticker-item {
    font-family: var(--mono);
    font-size: 0.7rem;
    font-weight: 800;
    color: #ffffff;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }

  .ticker-live-badge {
    background: var(--acid);
    color: #000000;
    font-size: 0.56rem;
    padding: 2px 6px;
    border-radius: 4px;
    font-weight: 900;
    letter-spacing: 0.08em;
  }

  .ticker-dot {
    color: var(--acid);
    font-size: 0.55rem;
  }

  /* ── HEADER CONTAINER ── */
  .header-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0.75rem 1rem 0;
    position: sticky;
    top: max(8px, env(safe-area-inset-top));
    z-index: 100;
  }

  /* ── HERO SECTION ── */
  .services-hero {
    padding: 1.5rem 1rem 2rem;
    background:
      radial-gradient(ellipse 70% 40% at 50% 0%, rgba(224, 255, 0, 0.09) 0%, transparent 70%),
      linear-gradient(180deg, #111114 0%, #09090b 100%);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .services-hero-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  /* BARRA METÁLICA DE PILARES COM SCROLL HORIZONTAL MOBILE */
  .metal-pillars-wrapper {
    width: 100%;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 0.35rem;
    margin-bottom: 1.25rem;
  }

  .metal-pillars-wrapper::-webkit-scrollbar {
    display: none;
  }

  .metal-pillars-bar {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.45rem 0.9rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 9999px;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    white-space: nowrap;
  }

  .metal-pillar-item {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .metal-pillar-item img {
    object-fit: contain;
    filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.6));
    flex-shrink: 0;
  }

  .engine-mini-logo {
    border-radius: 4px;
  }

  .metal-pillar-item span {
    font-family: var(--mono);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #e4e4e7;
  }

  .pillar-dot {
    color: var(--acid);
    font-size: 0.5rem;
    opacity: 0.8;
  }

  .hero-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--acid);
    margin-bottom: 0.75rem;
  }

  .kicker-dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--acid);
    box-shadow: 0 0 10px var(--acid);
  }

  .services-hero h1 {
    font-size: clamp(2rem, 7.5vw, 3.8rem);
    line-height: 1.05;
    font-weight: 900;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    margin: 0 0 0.85rem;
    color: #ffffff;
  }

  .hero-lead {
    font-size: clamp(0.92rem, 3.2vw, 1.12rem);
    line-height: 1.55;
    color: #a1a1aa;
    margin: 0 0 1.75rem;
    max-width: 720px;
  }

  /* BARRA DE FILTROS HORIZONTAIS MOBILE-FIRST */
  .filter-wrapper {
    width: 100%;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    margin: 0 -1rem;
    padding: 0.25rem 1rem;
  }

  .filter-wrapper::-webkit-scrollbar {
    display: none;
  }

  .filter-bar {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    white-space: nowrap;
    padding-bottom: 0.25rem;
  }

  .filter-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #d4d4d8;
    padding: 0.55rem 0.95rem;
    min-height: 40px;
    border-radius: 9999px;
    font-family: var(--mono);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  .filter-pill:active {
    transform: scale(0.96);
  }

  .filter-pill:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.25);
    color: #ffffff;
  }

  .filter-pill.is-active {
    background: var(--acid);
    border-color: var(--acid);
    color: #000000;
    font-weight: 900;
    box-shadow: 0 4px 16px rgba(224, 255, 0, 0.2);
  }

  .filter-pill-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 18px;
    height: 18px;
    padding: 0 4px;
    border-radius: 9999px;
    font-size: 0.62rem;
    font-weight: 900;
    background: rgba(255, 255, 255, 0.1);
    color: currentColor;
  }

  .filter-pill.is-active .filter-pill-count {
    background: #000000;
    color: var(--acid);
  }

  /* ── MAIN CONTAINER & GRID ── */
  .services-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1rem 5rem;
  }

  .services-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 640px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
    }
  }

  @media (min-width: 1024px) {
    .services-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.75rem;
    }
  }

  /* ── CARD DO PRODUTO (BENTO / MOBILE-FIRST) ── */
  .service-card {
    display: flex;
    flex-direction: column;
    background: #121215;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 1.15rem;
    overflow: hidden;
    position: relative;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.35);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .service-card:hover {
    transform: translateY(-4px);
    border-color: rgba(224, 255, 0, 0.32);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.5), 0 0 24px rgba(224, 255, 0, 0.06);
  }

  .service-card--featured {
    border-color: rgba(224, 255, 0, 0.35);
    background: linear-gradient(180deg, #17181c 0%, #111215 100%);
    box-shadow: 0 8px 24px rgba(224, 255, 0, 0.08);
  }

  /* ── CARD MEDIA (IMAGEM DO PRODUTO) ── */
  .service-card-media {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #0a0a0c;
    overflow: hidden;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .service-media-link {
    display: block;
    width: 100%;
    height: 100%;
    position: relative;
  }

  .service-media-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .service-card:hover .service-media-img {
    transform: scale(1.05);
  }

  .service-media-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.1) 0%, rgba(18, 18, 21, 0.85) 100%);
    pointer-events: none;
  }

  .service-media-badges {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    right: 0.75rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    pointer-events: none;
  }

  .service-category-badge {
    display: inline-flex;
    align-items: center;
    font-family: var(--mono);
    font-size: 0.65rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--acid);
    background: rgba(10, 10, 12, 0.85);
    border: 1px solid rgba(224, 255, 0, 0.28);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    padding: 0.25rem 0.55rem;
    border-radius: 0.35rem;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.4);
  }

  .service-partner-badge {
    width: 30px;
    height: 30px;
