{
  "openapi": "3.0.3",
  "info": {
    "title": "neo-flw-landing API Contracts",
    "version": "2026.07.28",
    "description": "Contratos server-side ativos do neo-flw-landing em Cloudflare Pages Functions. Pagamentos via FlowPay são integração externa planejada e não são servidos por Vercel nem por uma rota local ativa deste checkout."
  },
  "servers": [
    {
      "url": "https://neoflowoff.agency",
      "description": "Produção em Cloudflare Pages + Pages Functions"
    }
  ],
  "x-neo-runtime": {
    "repository": "neo-flw-landing",
    "runtime": "Astro static build",
    "server_side_surface": "Cloudflare Pages Functions",
    "deploy": "Cloudflare Pages",
    "not_used": [
      "Vercel Serverless Functions"
    ]
  },
  "x-neo-planned-integrations": {
    "flowpay": {
      "status": "planned_external_payment_node",
      "active_in_this_checkout": false,
      "owner": "FlowPay payment node",
      "current_note": "js/payment.js contains legacy FlowPay modal logic and fallback endpoints, but this Astro checkout does not currently expose a local payment API route.",
      "do_not_claim": [
        "PIX is generated by neo-flw-landing",
        "/api/create-charge-landing is active in this Cloudflare Pages Functions bundle",
        "Payments are hosted on Vercel"
      ],
      "expected_contracts_when_enabled": [
        "create charge",
        "read charge status",
        "payment confirmation notification"
      ]
    }
  },
  "paths": {
    "/api/meta/data-deletion": {
      "get": {
        "tags": [
          "Meta Data Deletion"
        ],
        "summary": "Health check do callback Meta Data Deletion",
        "description": "Retorna apenas o estado do endpoint. Não retorna URL de instruções nem referência à página legada /data-deletion/.",
        "responses": {
          "200": {
            "description": "Endpoint disponível",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthCheckResponse"
                },
                "example": {
                  "status": "ok"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Meta Data Deletion"
        ],
        "summary": "Callback de exclusão de dados da Meta",
        "description": "Recebe signed_request da Meta, valida HMAC SHA-256 com META_APP_SECRET no server-side e retorna a URL pública de acompanhamento em /excluir-dados.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MetaSignedRequestBody"
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/MetaSignedRequestBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Solicitação validada e registrada/encaminhada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DataDeletionSuccessResponse"
                },
                "example": {
                  "url": "https://neoflowoff.agency/excluir-dados?code=00000000-0000-4000-8000-000000000000",
                  "confirmation_code": "00000000-0000-4000-8000-000000000000"
                }
              }
            }
          },
          "400": {
            "description": "signed_request ausente, malformado ou com assinatura inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "missing_signed_request": {
                    "value": {
                      "ok": false,
                      "error": "missing_signed_request"
                    }
                  },
                  "invalid_signed_request": {
                    "value": {
                      "ok": false,
                      "error": "invalid_signed_request_signature"
                    }
                  }
                }
              }
            }
          },
          "502": {
            "description": "Backend soberano rejeitou o encaminhamento",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "META_APP_SECRET, KV ou handler seguro não configurado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "x-security-notes": [
          "META_APP_SECRET must remain server-side.",
          "Do not log META_APP_SECRET.",
          "Do not log the complete signed_request.",
          "The public user-facing deletion page is /excluir-dados/."
        ]
      }
    },
    "/api/meta/embedded-signup": {
      "post": {
        "tags": [
          "Meta Embedded Signup"
        ],
        "summary": "Recebe authorization code do Meta Embedded Signup",
        "description": "Adapter server-side estreito para encaminhar o code ao backend soberano ou trocar o code imediatamente e armazenar somente o payload de token criptografado quando KV e chave de criptografia estiverem configurados. O authorization code nao deve ser persistido no fallback KV.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmbeddedSignupRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Code encaminhado ou armazenado com segurança",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmbeddedSignupAcceptedResponse"
                }
              }
            }
          },
          "400": {
            "description": "JSON inválido ou authorization code ausente/inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "Falha ao trocar code com Meta ou backend soberano rejeitou encaminhamento",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Storage seguro não configurado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "x-security-notes": [
          "Authorization codes and access tokens must be processed server-side.",
          "Access tokens must not be exposed to the browser.",
          "This adapter does not make neo-flw-landing the sovereign WhatsApp backend."
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "HealthCheckResponse": {
        "type": "object",
        "required": [
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        }
      },
      "MetaSignedRequestBody": {
        "type": "object",
        "required": [
          "signed_request"
        ],
        "properties": {
          "signed_request": {
            "type": "string",
            "description": "Payload assinado pela Meta. Não registrar o valor bruto completo em logs."
          }
        }
      },
      "DataDeletionSuccessResponse": {
        "type": "object",
        "required": [
          "url",
          "confirmation_code"
        ],
        "additionalProperties": false,
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://neoflowoff\\.agency/excluir-dados\\?code="
          },
          "confirmation_code": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "EmbeddedSignupRequest": {
        "type": "object",
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "maxLength": 4096
          },
          "grantedScopes": {
            "type": "string"
          },
          "requestedScopes": {
            "type": "string"
          }
        }
      },
      "EmbeddedSignupAcceptedResponse": {
        "type": "object",
        "required": [
          "ok",
          "connection_id",
          "status"
        ],
        "properties": {
          "ok": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "connection_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "forwarded",
              "stored"
            ]
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "ok",
          "error"
        ],
        "properties": {
          "ok": {
            "type": "boolean",
            "enum": [
              false
            ]
          },
          "error": {
            "type": "string"
          },
          "meta_error_code": {
            "oneOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ],
            "nullable": true
          }
        }
      }
    }
  }
}
