---
import Base from '../layouts/Base.astro';
import configData from '../data/config.json';

const metaConfig = configData.integrations.meta;
const metaAppId = metaConfig.app_id;
const graphApiVersion = metaConfig.graph_api_version;
const requestedScopes = metaConfig.requested_scopes.join(',');
---
<Base title="Conectar WhatsApp — Meta Embedded Signup | NEØ FlowOFF">
  <div style="min-height: 80vh; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 2rem 1rem; text-align: center;">
    <div style="max-width: 480px; width: 100%; background: #1c1c20; border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 24px; padding: 2.5rem 1.8rem; box-shadow: 0 16px 45px rgba(0, 0, 0, 0.6);">
      
      <!-- LOGO META / WHATSAPP BADGE -->
      <div style="display: inline-flex; align-items: center; gap: 8px; font-family: var(--mono); font-size: 0.7rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em; color: var(--acid); background: rgba(200, 212, 26, 0.1); padding: 6px 14px; border-radius: 999px; border: 1px solid rgba(200, 212, 26, 0.3); margin-bottom: 1.5rem;">
        <span style="width: 7px; height: 7px; border-radius: 50%; background: var(--acid);"></span>
        <span>Meta Tech Provider — Embedded Signup</span>
      </div>

      <h1 style="font-size: 1.5rem; font-weight: 900; color: #ffffff; margin-bottom: 0.8rem; text-transform: uppercase; letter-spacing: -0.01em;">
        Conectar WhatsApp Business
      </h1>

      <p style="color: rgba(255, 255, 255, 0.7); font-size: 0.9rem; line-height: 1.6; margin-bottom: 2rem;">
        Vincule sua conta do WhatsApp Business Management e conceda permissões de envio e gerenciamento de mensagens via infraestrutura oficial Meta Tech Provider.
      </p>

      <!-- BOTÃO EMBEDDED SIGNUP META -->
      <button 
        id="btn-meta-signup" 
        onclick="launchWhatsAppSignup()" 
        style="width: 100%; background: var(--acid); color: #0b0b0d; border: none; padding: 16px 24px; font-size: 1rem; font-weight: 800; border-radius: 12px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 10px; box-shadow: 0 8px 24px rgba(200, 212, 26, 0.28); transition: transform 0.2s ease, background 0.2s ease;"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
          <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
        </svg>
        Conectar WhatsApp com Meta
      </button>

      <div id="signup-status" style="margin-top: 1.5rem; font-family: var(--mono); font-size: 0.78rem; color: #c8d41a; display: none;"></div>

      <div style="margin-top: 2rem; padding-top: 1.2rem; border-top: 1px solid rgba(255, 255, 255, 0.08); font-size: 0.72rem; color: rgba(255, 255, 255, 0.4);">
        App: NEØ FLOW E-gine (ID: {metaAppId}) · Graph API {graphApiVersion}
      </div>

    </div>
  </div>

  <script is:inline define:vars={{ metaAppId, graphApiVersion, requestedScopes }}>
    function setSignupStatus(message, tone) {
      const statusDiv = document.getElementById('signup-status');
      if (!statusDiv) return;
      statusDiv.style.display = 'block';
      statusDiv.style.color = tone === 'error' ? '#ff6b6b' : '#c8d41a';
      statusDiv.textContent = message;
    }

    async function confirmEmbeddedSignup(authResponse) {
      const code = authResponse && authResponse.code;
      if (!code) {
        throw new Error('missing_authorization_code');
      }

      const response = await fetch('/api/meta/embedded-signup', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          code,
          grantedScopes: authResponse.grantedScopes || authResponse.granted_scopes || '',
          requestedScopes
        })
      });

      const payload = await response.json().catch(() => ({}));
      if (!response.ok || !payload.ok) {
        throw new Error(payload.error || 'embedded_signup_not_confirmed');
      }

      return payload;
    }

    window.fbAsyncInit = function() {
      FB.init({
        appId      : metaAppId,
        cookie     : true,
        xfbml      : true,
        version    : graphApiVersion
      });
    };

    window.launchWhatsAppSignup = function() {
      const button = document.getElementById('btn-meta-signup');
      if (!window.FB) {
        setSignupStatus('SDK da Meta ainda não carregou. Tente novamente em instantes.', 'error');
        return;
      }

      if (button) {
        button.setAttribute('disabled', 'disabled');
        button.style.opacity = '0.7';
      }
      setSignupStatus('Abrindo autorização da Meta...', 'info');

      FB.login(async function (response) {
        if (response.authResponse) {
          try {
            setSignupStatus('Confirmando conexão com o backend seguro...', 'info');
            await confirmEmbeddedSignup(response.authResponse);
            setSignupStatus('Conexão confirmada. A infraestrutura recebeu a autorização com segurança.', 'info');
          } catch {
            setSignupStatus('A autorização foi recebida pela Meta, mas ainda não foi confirmada pelo backend seguro.', 'error');
          }
        } else {
          setSignupStatus('Login cancelado ou não autorizado.', 'error');
        }

        if (button) {
          button.removeAttribute('disabled');
          button.style.opacity = '1';
        }
      }, {
        scope: requestedScopes,
        return_scopes: true,
        response_type: 'code'
      });
    }
  </script>
  <script async defer crossorigin="anonymous" src="https://connect.facebook.net/pt_BR/sdk.js"></script>
</Base>
