---
import catalogData from '../../data/catalog.json';
import uiTexts from '../../data/ui_texts.json';
import Base from '../../layouts/Base.astro';
import steelLogoImage from '../../assets/images/steel_flw.webp';

export function getStaticPaths() {
  const planos = catalogData.products.filter(p => p.category === 'Plano');
  return planos.map(plano => ({
    params: { slug: plano.slug },
    props: { plano },
  }));
}

const { plano } = Astro.props;
---
<Base title={`${plano.title} | NEØ FlowOFF`} description={`${plano.description} Plano da Neo FlowOFF Agency para infraestrutura comercial, CRM, automação e agentes de IA.`}>
  <div class="detail-page">
    <header class="detail-header">
      <a href="/" class="back-link">
        <i data-lucide="chevron-left"></i>
        <span>{uiTexts.product_page.back_button}</span>
      </a>
    </header>

    <article class="detail-hero">
      <div class="detail-hero-copy">
        {plano.featured && (
          <div class="detail-status-chip">
            OPERAÇÃO PRINCIPAL
          </div>
        )}
        <div class="detail-kicker">{plano.display_category || uiTexts.product_page.plan_label}</div>
        <h1>{plano.title}</h1>
        <p>{plano.description}</p>
      </div>
      <aside class="detail-price-panel" aria-label="Resumo de preço">
        {plano.price_label && <span>{plano.price_label}</span>}
        <strong>{plano.price_display || (plano.price.value > 0 ? `R$ ${plano.price.value.toLocaleString('pt-BR', { minimumFractionDigits: 2 })}` : 'Sob consulta')}</strong>
        <small>Pacote completo com diagnóstico e implantação.</small>
      </aside>
    </article>

    <section class="detail-section">
      <div class="section-label">{uiTexts.product_page.included_features_label}</div>
      <ul class="detail-list">
        {plano.features.map(feature => (
          <li>
            <i data-lucide="check-circle"></i>
            <span>{feature}</span>
          </li>
        ))}
      </ul>
    </section>

    {plano.outcomes && (
      <section class="detail-section detail-section--panel">
        <div class="section-label">{uiTexts.product_page.outcomes_label}</div>
        <ul class="detail-list detail-list--outcomes">
          {plano.outcomes.map(outcome => (
            <li>
              <i data-lucide="sparkles"></i>
              <span>{outcome}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="detail-cta" aria-label="Próximo passo">
      <p>
        {uiTexts.product_page.pricing_notice}
      </p>

      <div class="detail-actions">
        {plano.flowpay_url ? (
          <a
            href={plano.flowpay_url}
            target="_blank"
            rel="noopener noreferrer"
            class="detail-action detail-action--primary"
          >
            <i data-lucide="credit-card"></i>
            <span>Pagar via PIX ({plano.price_display})</span>
          </a>
        ) : (
          <a
            href={`https://wa.me/556282705594?text=Olá!%20Gostaria%20de%20contratar%20o%20plano%20${encodeURIComponent(plano.title)}.%20[utm:plano-${encodeURIComponent(plano.slug)}]`}
            target="_blank"
            rel="noopener noreferrer"
            class="detail-action detail-action--primary"
          >
            <i data-lucide="credit-card"></i>
            <span>{uiTexts.product_page.checkout_button}</span>
          </a>
        )}

        <a href={`https://wa.me/556282705594?text=Olá!%20Gostaria%20de%20validar%20o%20escopo%20do%20plano%20${encodeURIComponent(plano.title)}.%20[utm:plano-${encodeURIComponent(plano.slug)}]`} target="_blank" rel="noopener noreferrer" class="detail-action detail-action--secondary">
          <i data-lucide="message-circle"></i>
          <span>{uiTexts.product_page.contact_button}</span>
        </a>
      </div>
    </section>

    <footer class="detail-footer">
      <img class="detail-footer-logo" src={steelLogoImage.src} width={steelLogoImage.width} height={steelLogoImage.height} alt="Logotipo Neo FlowOFF Agency - infraestrutura comercial e IA" loading="lazy" decoding="async" />
      <p>
        {uiTexts.footer.tagline}
      </p>
      <img class="detail-footer-badge" src="/assets/badge_meta_tech_provider.webp" alt="Neo FlowOFF Agency - Meta Tech Provider para WhatsApp Business API" loading="lazy" decoding="async" width="1400" height="401" />
      <p class="footer-legal-entity">
        <span>Flowoff Marketing e Assessoria Digital LTDA</span>
        <span class="footer-legal-nobreak">• CNPJ: 43.376.355/0001-92</span>
        <span class="footer-legal-nobreak">• neo@neoflowoff.agency</span>
      </p>
    </footer>
  </div>

  <script is:inline define:vars={{
    title: plano.title,
    id: plano.id,
    price: plano.price.value
  }}>
    // 1. ViewContent (Meta & TikTok)
    if (typeof ttq !== 'undefined') {
      ttq.track('ViewContent', {
        content_id: id,
        content_type: 'product',
        content_name: title,
        quantity: 1,
        price: price,
        value: price,
        currency: 'BRL',
        contents: [{
          content_id: id,
          content_name: title,
          content_type: 'product',
          quantity: 1,
          price: price
        }]
      });
    }
    if (typeof fbq !== 'undefined') {
      fbq('track', 'ViewContent', {
        content_name: title,
        content_ids: [id],
        content_type: 'product',
        value: price,
        currency: 'BRL'
      });
    }

    // 2. Click tracking for CTA buttons
    document.addEventListener('DOMContentLoaded', () => {
      const checkoutBtn = document.querySelector('.detail-action--primary');
      const whatsappBtn = document.querySelector('.detail-action--secondary');

      if (checkoutBtn) {
        checkoutBtn.addEventListener('click', () => {
          if (typeof ttq !== 'undefined') {
            ttq.track('AddToCart', {
              content_id: id,
              content_type: 'product',
              content_name: title,
              quantity: 1,
              price: price,
              value: price,
              currency: 'BRL',
              contents: [{
                content_id: id,
                content_name: title,
                content_type: 'product',
                quantity: 1,
                price: price
              }]
            });
            ttq.track('InitiateCheckout', {
              content_id: id,
              content_type: 'product',
              content_name: title,
              quantity: 1,
              price: price,
              value: price,
              currency: 'BRL',
              contents: [{
                content_id: id,
                content_name: title,
                content_type: 'product',
                quantity: 1,
                price: price
              }]
            });
          }
          if (typeof fbq !== 'undefined') {
            fbq('track', 'AddToCart', {
              content_name: title,
              content_ids: [id],
              content_type: 'product',
              value: price,
              currency: 'BRL'
            });
            fbq('track', 'InitiateCheckout', {
              content_name: title,
              content_ids: [id],
              content_type: 'product',
              value: price,
              currency: 'BRL'
            });
          }
        });
      }

      if (whatsappBtn) {
        whatsappBtn.addEventListener('click', () => {
          if (typeof ttq !== 'undefined') {
            ttq.track('CompletePayment', {
              content_id: id,
              content_type: 'product',
              content_name: title,
              quantity: 1,
              price: price,
              value: price,
              currency: 'BRL',
              contents: [{
                content_id: id,
                content_name: title,
                content_type: 'product',
                quantity: 1,
                price: price
              }]
            });
          }
          if (typeof fbq !== 'undefined') {
            fbq('track', 'Purchase', {
              content_name: title,
              content_ids: [id],
              content_type: 'product',
              value: price,
              currency: 'BRL'
            });
          }
        });
      }
    });
  </script>
</Base>
